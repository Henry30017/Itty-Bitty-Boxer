    ];

    let pColor1 = equippedHairShape === 'BALD' ? '#f8c291' : equippedHair;
    let pColor2 = shadeColor(pColor1, -20);
    buildSprite('pHead', 12, 10, scale, hairShapes[equippedHairShape], { '0': '#000', '1': pColor1, '2': pColor2 });
    buildSprite('pGlove', 8, 7, scale, gloveData, { '0': '#000', '1': equippedGlove, 'W': '#fff' });

