<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pixel Punch-Out: Modern RPG</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

        :root {
            --bg-color: #0f0f15;
            --primary: #ff2a4b;
            --secondary: #00d2ff;
            --text: #ffffff;
            --panel: rgba(20, 20, 30, 0.95);
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text);
            font-family: 'Press Start 2P', monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
            user-select: none;
        }

        #game-wrapper {
            position: relative;
            width: 900px;
            height: 650px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.9), 0 0 0 4px #222;
            background-color: #000;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            image-rendering: pixelated; 
        }

        .ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .hidden { display: none !important; }

        /* HUD */
        #hud {
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .hud-panel {
            background: rgba(0, 0, 0, 0.85);
            padding: 12px;
            border: 2px solid #555;
            border-radius: 4px;
            box-shadow: 0 4px 0 rgba(0,0,0,0.5);
        }

        .bars { width: 240px; display: flex; flex-direction: column; gap: 8px; }
        .bar-bg { width: 100%; height: 16px; background: #222; border: 2px solid #fff; position: relative; }
        .bar-fill { height: 100%; transition: width 0.1s ease-out; }
        
        #p-hp-fill { background: #ff2a4b; width: 100%; }
        #p-block-fill { background: #00d2ff; width: 100%; }
        #e-hp-fill { background: #ff2a4b; width: 100%; transform-origin: right; float: right; }
        
        .label { font-size: 10px; text-shadow: 1px 1px #000; letter-spacing: 1px; color: #fff;}

        /* Fight Score */
        #fight-score {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: rgba(0,0,0,0.8); padding: 10px 20px; border: 2px solid #f1c40f; border-radius: 4px;
        }

        /* Wallet & Career Tracker */
        .top-ui-box {
            position: absolute;
            top: 15px;
            background: rgba(0,0,0,0.8);
            padding: 10px 15px;
            border: 2px solid #555;
            color: #fff;
            font-size: 12px;
            border-radius: 4px;
            text-shadow: 1px 1px #000;
            z-index: 50;
        }
        
        #wallet-ui { left: 50%; transform: translateX(-50%); border-color: #f1c40f; color: #f1c40f; }
        #career-ui { right: 15px; text-align: right; }

        /* Interaction Prompt */
        #interact-prompt {
            position: absolute;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%);
            background: #fff;
            color: #000;
            padding: 10px 20px;
            border-radius: 4px;
            font-size: 12px;
            box-shadow: 0 4px 0 #ccc;
            animation: bounce 1s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translate(-50%, 0); }
            50% { transform: translate(-50%, -5px); }
        }

        /* Shop UI */
        #shop-ui {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: var(--panel);
            border: 4px solid #f1c40f;
            padding: 30px;
            pointer-events: auto;
            text-align: center;
            width: 600px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.9);
            z-index: 200;
        }

        .shop-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 20px;
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .shop-tabs { display: flex; gap: 10px; margin-bottom: 15px; }
        .shop-tabs button.active { background: #f1c40f; color: #000; border-color: #fff; }

        .color-preview { width: 30px; height: 30px; border: 2px solid #fff; border-radius: 50%; margin-bottom: 10px; }

        .shop-item {
            background: #111; border: 2px solid #555; padding: 15px;
            display: flex; flex-direction: column; align-items: center; gap: 10px;
        }

        .shop-item h3 { font-size: 12px; margin: 0; color: #aaa; line-height: 1.4; }
        .shop-item .stat { font-size: 10px; color: #00d2ff; }
        .shop-item .cost { font-size: 14px; color: #f1c40f; }

        button {
            font-family: 'Press Start 2P', monospace; background: #444; color: white;
            border: 2px solid #666; padding: 12px; font-size: 12px; cursor: pointer;
            width: 100%; transition: all 0.2s;
        }
        button:hover:not(:disabled) { background: #f1c40f; color: #000; border-color: #fff; }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        .close-btn { background: #ff2a4b; margin-top: 20px; width: auto; padding: 10px 30px;}
        .close-btn:hover:not(:disabled) { background: #ff5271; }

        /* Screens */
        .screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9); display: flex; flex-direction: column;
            justify-content: center; align-items: center; pointer-events: auto; text-align: center;
            z-index: 300;
        }

        h1 { font-size: 40px; color: var(--primary); text-shadow: 4px 4px #000; margin-bottom: 10px; }
        h2 { font-size: 24px; color: #f1c40f; margin-bottom: 20px; }

        /* Tutorial/Controls */
        .controls-info {
            position: absolute; bottom: 10px; right: 10px; background: rgba(0,0,0,0.85);
            padding: 8px 12px; font-size: 7px; line-height: 1.6; color: #ccc; 
            border: 1px solid #444; text-align: left; border-radius: 4px;
            z-index: 50;
        }
    </style>
</head>
