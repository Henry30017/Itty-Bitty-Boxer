            "01121112110 ",
            "021111211110",
            " 0112111120 ",
            " 0111121110 ",
            " 0211111110 ",
            "  01121110  ",
            "  00000000  ",
            "            "
        ],
        'AFRO': [
            "  00000000  ",
            " 0112111210 ",
            "012111211110",
            "011121112110",
            "021111211120",
            "011211121110",
            " 0111211110 ",
