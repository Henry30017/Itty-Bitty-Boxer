generateSprites();

// --- ENTITIES ---
class Character {
    constructor(x, y, isPlayer) {
        this.x = x;
        this.y = y;
        this.isPlayer = isPlayer;
        this.radius = 20; 
        
        this.maxHp = 100;
        this.fightMaxHp = undefined; 
        this.hp = 100;
        this.maxBlock = 50;
        this.blockHealth = 50;
        this.baseDmg = 10;
        this.speed = 180;
        
        this.state = 'IDLE'; 
        this.facingAngle = 0;
        this.animTime = 0;
        
        this.isBlockBroken = false;
        this.actionTimer = 0;
        this.dodgeCooldown = 0;

        // Visual offsets
        this.lGloveExt = 0;
        this.rGloveExt = 0;
    }

    update(dt) {
        this.animTime += dt;

        if (this.state !== 'BLOCKING') {
            this.blockHealth += (this.maxBlock * 0.25) * dt;
            if (this.blockHealth >= this.maxBlock) {
                this.blockHealth = this.maxBlock;
                this.isBlockBroken = false;
            }
        }

        if (this.dodgeCooldown > 0) this.dodgeCooldown -= dt;
        
        if (this.actionTimer > 0) {
            this.actionTimer -= dt;
            
            // Animate punches
            if (this.state === 'ATTACK_LIGHT' || this.state === 'ATTACK_HEAVY') {
                let duration = this.state === 'LIGHT' ? 0.3 : 0.6;
                let progress = 1 - (this.actionTimer / duration);
                
                let ext = 0;
                if (progress < 0.3) { ext = -10; } 
                else if (progress < 0.6) { ext = 35; } 
                else { ext = 35 * (1 - ((progress-0.6)/0.4)); } 

                if (this.state === 'ATTACK_LIGHT') this.lGloveExt = ext;
                if (this.state === 'ATTACK_HEAVY') this.rGloveExt = ext;
            }

            if (this.actionTimer <= 0) {
                this.state = 'IDLE';
                this.lGloveExt = 0;
                this.rGloveExt = 0;
            }
        }

        if (this.state === 'BLOCKING') {
            this.lGloveExt = 5; this.rGloveExt = 5;
            // Heal 1 HP/sec while blocking
            let max = this.fightMaxHp || this.maxHp;
            if (this.hp < max) {
                this.hp = Math.min(max, this.hp + 1 * dt);
                this.healTick = (this.healTick || 0) + dt;
                if (this.healTick > 1.0) {
                    spawnText(this.x, this.y - 30, "+1 HP", "#2ecc71");
                    this.healTick = 0;
                }
            }
        } else if (!this.state.startsWith('ATTACK')) {
            this.lGloveExt = 0; this.rGloveExt = 0;
        }

        if (this.state === 'DODGING') {
            const dodgeAngle = this.facingAngle + (Math.PI / 2 * this.dodgeSide);
            this.x += Math.cos(dodgeAngle) * (this.speed * 2.5) * dt;
            this.y += Math.sin(dodgeAngle) * (this.speed * 2.5) * dt;
        }
    }

    draw(ctx) {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.facingAngle);

        const prefix = this.isPlayer ? 'p' : 'e';
        const head = sprites[prefix + 'Head'];
        const glove = sprites[prefix + 'Glove'];

        let breath = this.state === 'IDLE' ? Math.sin(this.animTime * 4) * 1 : 0;

        // Shadow
        ctx.fillStyle = 'rgba(0,0,0,0.3)';
        ctx.beginPath(); ctx.ellipse(0, 0, 16, 16, 0, 0, Math.PI*2); ctx.fill();

        // Gloves
        let lx = 14 + this.lGloveExt, ly = -18;
        let rx = 14 + this.rGloveExt, ry = 18 - glove.height;
        
        if (this.state === 'BLOCKING') { lx = 12; ly = -12; rx = 12; ry = 12 - glove.height; }
        
        ctx.drawImage(glove, lx, ly, glove.width, glove.height);
        ctx.drawImage(glove, rx, ry, glove.width, glove.height);

        // Head (Hair/Skin Top)
        ctx.drawImage(head, -head.width/2 + breath, -head.height/2, head.width, head.height);

        // Block Shield
        if (this.state === 'BLOCKING') {
            ctx.beginPath();
            ctx.arc(15, 0, 30, -Math.PI/2.5, Math.PI/2.5);
            ctx.strokeStyle = this.isBlockBroken ? 'rgba(255,0,0,0.5)' : 'rgba(0, 210, 255, 0.6)';
            ctx.lineWidth = 6;
            ctx.stroke();
        }

        ctx.restore();
    }

    performAttack(type) {
        if (this.state.startsWith('ATTACK') || this.state === 'DODGING' || this.state === 'STUNNED') return;
        
        this.state = type === 'LIGHT' ? 'ATTACK_LIGHT' : 'ATTACK_HEAVY';
        let windup = type === 'LIGHT' ? 0.1 : 0.25;
        this.actionTimer = type === 'LIGHT' ? 0.3 : 0.6;

        setTimeout(() => {
            if (gameState !== 'FIGHT' || this.state === 'STUNNED') return;
            let target = this.isPlayer ? enemy : player;
            
            let dist = MathUtils.dist(this.x, this.y, target.x, target.y);
            let reach = type === 'LIGHT' ? 70 : 90;
            
            let angleToTarget = Math.atan2(target.y - this.y, target.x - this.x);
            let angleDiff = Math.abs(angleToTarget - this.facingAngle);
            if (angleDiff > Math.PI) angleDiff = 2 * Math.PI - angleDiff;

            if (dist <= reach && angleDiff < Math.PI/2.5 && target.state !== 'DODGING') {
                let damage = type === 'LIGHT' ? this.baseDmg : this.baseDmg * 2.5;
                applyHit(this, target, damage, type);
            }
        }, windup * 1000);
    }

    performDodge(side) {
        if (this.dodgeCooldown > 0 || this.state === 'DODGING' || this.state.startsWith('ATTACK')) return;
        this.state = 'DODGING';
        this.dodgeSide = side; 
        this.actionTimer = 0.3; 
        this.dodgeCooldown = 0.8;
    }
}

let player = new Character(450, 400, true);
let enemy = new Character(450, 200, false);

// --- COMBAT LOGIC ---
function applyHit(attacker, defender, damage, type) {
    let hitX = defender.x;
    let hitY = defender.y - 30;

    if (defender.state === 'BLOCKING' && !defender.isBlockBroken) {
        defender.blockHealth -= damage * 1.8;
        defender.hp -= damage * 0.1; 
        spawnText(hitX, hitY, "BLOCKED", "#00d2ff");

        if (defender.blockHealth <= 0) {
            defender.blockHealth = 0;
            defender.isBlockBroken = true;
            defender.state = 'STUNNED';
            defender.actionTimer = 0.8;
            spawnText(defender.x, defender.y - 40, "GUARD BREAK!", "#ff2a4b");
        }
    } else {
        defender.hp -= damage;
        
        let pushStr = type === 'HEAVY' ? 25 : 10;
        defender.x += Math.cos(attacker.facingAngle) * pushStr;
        defender.y += Math.sin(attacker.facingAngle) * pushStr;
        
        spawnText(hitX, hitY, "-" + Math.floor(damage), type === 'HEAVY' ? "#ff2a4b" : "#fff");
    }

    updateFightHUD();
}

// --- WORLD GENERATION & MAPS ---
function generateRings() {
    rings = [];
    const padY = 400;
    const padXs = [180, 450, 720];
    const ringSize = 220;
    
    let pLevel = upgrades.hp + upgrades.dmg + upgrades.block - 3; 

    for(let i=0; i<3; i++) {
        let r = Math.random() * 100;
        let diff = 'EASY';

        if (pLevel < 3) {
            if (r > 80) diff = 'MEDIUM';
        } else if (pLevel < 8) {
            if (r < 30) diff = 'EASY'; else if (r < 80) diff = 'MEDIUM'; else diff = 'HARD';
        } else {
            if (r < 10) diff = 'EASY'; else if (r < 40) diff = 'MEDIUM'; else if (r < 80) diff = 'HARD'; else diff = 'PRO';
        }

        rings.push({
            x: padXs[i], y: padY, size: ringSize,
            difficulty: diff,
            data: difficulties[diff],
            entryTimer: 0
        });
    }
}

function updatePlayerStats() {
    player.maxHp = 100 + (upgrades.hp - 1) * 20;
    player.fightMaxHp = undefined; 
    player.hp = player.maxHp;
    player.baseDmg = 10 + (upgrades.dmg - 1) * 4;
    player.maxBlock = 50 + (upgrades.block - 1) * 15;
    player.blockHealth = player.maxBlock;
}

function startQTERound() {
    qte.key = qteKeys[Math.floor(Math.random() * qteKeys.length)];
    qte.targetStart = Math.random() * Math.PI * 1.5; 
    qte.targetEnd = qte.targetStart + Math.PI * 0.4; 
    qte.angle = 0;
    qte.state = 'SPINNING';
    qte.timer = 0;
    qte.round++;
}

function endQTE() {
    gameState = 'FIGHT';
    player.fightMaxHp = player.maxHp + qte.bonus;
    player.hp = player.fightMaxHp;
    
    // MAKE HUD VISIBLE FOR THE FIGHT
    uiFightHud.classList.remove('hidden');
    
    updateFightHUD();
}

function resetRound(playerWonRound) {
    gameState = 'ROUND_TRANSITION';
    
    if (playerWonRound) {
        playerScore++;
        spawnText(450, 325, "ROUND WON!", "#2ecc71");
    } else {
        enemyScore++;
        spawnText(450, 325, "ROUND LOST!", "#e74c3c");
    }
    
    document.getElementById('score-player').innerText = playerScore;
    document.getElementById('score-enemy').innerText = enemyScore;

    if (playerScore >= 3) {
        setTimeout(() => {
            gameState = 'WIN';
            let reward = currentRing.data.reward;
            money += reward;
            currentDays++;
            bestDays = Math.max(bestDays, currentDays);
            
            uiMoney.innerText = money;
            updateDaysUI();
            
            document.getElementById('win-reward').innerText = "+$" + reward;
            screens.win.classList.remove('hidden');
            uiFightHud.classList.add('hidden');
            setTimeout(returnToLobby, 2500);
        }, 1500);
    } else if (enemyScore >= 3) {
        setTimeout(() => {
            gameState = 'GAMEOVER';
            bestDays = Math.max(bestDays, currentDays);
            updateDaysUI();
            screens.over.classList.remove('hidden');
            uiFightHud.classList.add('hidden');
        }, 1500);
    } else {
        // Next Round Setup
        setTimeout(() => {
            player.hp = player.fightMaxHp || player.maxHp;
            player.blockHealth = player.maxBlock;
            enemy.hp = enemy.maxHp;
            enemy.blockHealth = enemy.maxBlock;
            
            let h = currentRing.size / 2 - 40;
            player.x = currentRing.x - h; 
            player.y = currentRing.y + h;
            player.facingAngle = -Math.PI/4;
            
            enemy.x = currentRing.x + h; 
            enemy.y = currentRing.y - h;
            enemy.facingAngle = Math.PI * 0.75;
            
            player.state = 'IDLE';
            enemy.state = 'IDLE';

            gameState = 'FIGHT';
            updateFightHUD();
        }, 2000);
    }
}

// --- UPDATES ---
function updateLobby(dt) {
    let vx = 0, vy = 0;
    if (keys['KeyW']) vy -= 1;
    if (keys['KeyS']) vy += 1;
    if (keys['KeyA']) vx -= 1;
    if (keys['KeyD']) vx += 1;

    if (vx !== 0 || vy !== 0) {
        let len = Math.hypot(vx, vy);
        vx /= len; vy /= len;
        player.state = 'MOVING';
        player.facingAngle = Math.atan2(vy, vx);
    } else {
        player.state = 'IDLE';
    }

    player.x += vx * player.speed * dt;
    player.y += vy * player.speed * dt;

    player.x = MathUtils.clamp(player.x, 30, 870);
    player.y = MathUtils.clamp(player.y, 80, 620); 

    player.animTime += dt;

    // Shop Interaction
    if (Math.abs(player.x - shopZone.x) < 100 && Math.abs(player.y - shopZone.y) < 80) {
        uiInteract.classList.remove('hidden');
        if (justPressed['KeyF']) { openShop(); justPressed['KeyF'] = false; }
    } else {
        uiInteract.classList.add('hidden');
    }

    // Ring Entry Check
    for (let r of rings) {
        let entryX = r.x - r.size/2 + 20;
        let entryY = r.y + r.size/2 - 20;
        
        if (MathUtils.dist(player.x, player.y, entryX, entryY) < 35) {
            r.entryTimer += dt;
            if (r.entryTimer >= 2.0) {
                initiateFightSequence(r);
                break;
            }
        } else {
            r.entryTimer = 0;
        }
    }
}

function updateQTE(dt) {
    currentRing.x = MathUtils.lerp(currentRing.x, 450, dt * 4);
    currentRing.y = MathUtils.lerp(currentRing.y, 325, dt * 4);
    currentRing.size = MathUtils.lerp(currentRing.size, 650, dt * 4);
    
    let h = currentRing.size / 2 - 40;
    player.x = currentRing.x - h; 
    player.y = currentRing.y + h;
    enemy.x = currentRing.x + h; 
    enemy.y = currentRing.y - h;

    if (qte.state === 'SPINNING') {
        qte.angle += qte.speed * dt;
        
        let pressedKey = null;
        for (let k of qteKeys) {
            if (justPressed[k]) { pressedKey = k; break; }
        }

        // Spins twice (Math.PI * 4) before failing
        if (qte.angle > Math.PI * 4) {
            qte.state = 'MISS';
            qte.timer = 1.0;
            qte.bonus -= 10;
        } else if (pressedKey) {
            let normalizedAngle = qte.angle % (Math.PI * 2);
            if (pressedKey === qte.key && normalizedAngle >= qte.targetStart && normalizedAngle <= qte.targetEnd) {
                qte.state = 'HIT';
                qte.bonus += 10;
            } else {
                qte.state = 'MISS';
                qte.bonus -= 10;
            }
            qte.timer = 1.0;
        }
        
        for (let k in justPressed) justPressed[k] = false;
    } else if (qte.state === 'WAIT') {
        qte.timer -= dt;
        if (qte.timer <= 0) startQTERound();
    } else {
        qte.timer -= dt;
        if (qte.timer <= 0) {
            if (qte.round < 3) {
                qte.state = 'WAIT';
                qte.timer = 0.5;
            } else {
                endQTE();
            }
        }
    }
}

function updateFight(dt) {
    currentRing.x = MathUtils.lerp(currentRing.x, 450, dt * 4);
    currentRing.y = MathUtils.lerp(currentRing.y, 325, dt * 4);
    currentRing.size = MathUtils.lerp(currentRing.size, 650, dt * 4);

    if (player.state !== 'ATTACK_LIGHT' && player.state !== 'ATTACK_HEAVY' && player.state !== 'DODGING' && player.state !== 'STUNNED') {
        let vx = 0, vy = 0;
        
        if (keys['KeyW']) vy -= 1;
        if (keys['KeyS']) vy += 1;
        if (keys['KeyA']) vx -= 1;
        if (keys['KeyD']) vx += 1;
        
        if (vx !== 0 || vy !== 0) {
            let len = Math.hypot(vx, vy);
            vx /= len; vy /= len;
        }

        player.facingAngle = Math.atan2(enemy.y - player.y, enemy.x - player.x);

        if (keys['KeyL'] && !player.isBlockBroken) {
            player.state = 'BLOCKING';
            vx *= 0.3; vy *= 0.3;
        } else {
            player.state = (vx !== 0 || vy !== 0) ? 'MOVING' : 'IDLE';
        }

        player.x += vx * player.speed * dt;
        player.y += vy * player.speed * dt;

        if (justPressed['KeyJ']) { player.performAttack('LIGHT'); justPressed['KeyJ'] = false; }
        if (justPressed['KeyK']) { player.performAttack('HEAVY'); justPressed['KeyK'] = false; }
        
        if (justPressed['KeyQ']) { player.performDodge(-1); justPressed['KeyQ'] = false; }
        if (justPressed['KeyE']) { player.performDodge(1); justPressed['KeyE'] = false; }
    }

    if (enemy.state !== 'ATTACK_LIGHT' && enemy.state !== 'ATTACK_HEAVY' && enemy.state !== 'DODGING' && enemy.state !== 'STUNNED') {
        let dist = MathUtils.dist(enemy.x, enemy.y, player.x, player.y);
        enemy.facingAngle = Math.atan2(player.y - enemy.y, player.x - enemy.x);

        let isLowHp = enemy.hp < enemy.maxHp * 0.3;
        if (isLowHp && currentRing.data.healRate > 0) {
            enemy.hp = Math.min(enemy.maxHp, enemy.hp + currentRing.data.healRate * dt);
            enemy.healTimer = (enemy.healTimer || 0) + dt;
            if (enemy.healTimer > 0.5) {
                spawnText(enemy.x, enemy.y - 30, "+HP", "#2ecc71");
                enemy.healTimer = 0;
            }
            
            if (dist < 200) { 
                enemy.state = 'MOVING';
                enemy.x -= Math.cos(enemy.facingAngle) * enemy.speed * 1.1 * dt;
                enemy.y -= Math.sin(enemy.facingAngle) * enemy.speed * 1.1 * dt;
            } else {
                enemy.state = 'IDLE';
            }
        } else {
            if (dist > 80) {
                enemy.state = 'MOVING';
                enemy.x += Math.cos(enemy.facingAngle) * enemy.speed * dt;
                enemy.y += Math.sin(enemy.facingAngle) * enemy.speed * dt;
            } else {
                enemy.state = 'IDLE';
                if (Math.random() < currentRing.data.aggro) {
                    if (Math.random() < 0.6) enemy.performAttack('LIGHT');
                    else enemy.performAttack('HEAVY');
                } else if (Math.random() < 0.05 && !enemy.isBlockBroken) {
                    enemy.state = 'BLOCKING';
                    enemy.actionTimer = 1.0; 
                }
            }
        }

        if (player.state.startsWith('ATTACK') && enemy.dodgeCooldown <= 0) {
            if (Math.random() < currentRing.data.dodgeChance * dt * 4) {
                enemy.performDodge(Math.random() < 0.5 ? -1 : 1);
            }
        }
    }

    player.update(dt);
    enemy.update(dt);

    let distToEnemy = MathUtils.dist(player.x, player.y, enemy.x, enemy.y);
    let minDist = player.radius + enemy.radius;
    if (distToEnemy < minDist) {
        let angle = Math.atan2(enemy.y - player.y, enemy.x - player.x);
        let overlap = minDist - distToEnemy;
        player.x -= Math.cos(angle) * (overlap / 2);
        player.y -= Math.sin(angle) * (overlap / 2);
        enemy.x += Math.cos(angle) * (overlap / 2);
        enemy.y += Math.sin(angle) * (overlap / 2);
    }

    let halfSize = (currentRing.size / 2) - 20;
    player.x = MathUtils.clamp(player.x, currentRing.x - halfSize, currentRing.x + halfSize); 
    player.y = MathUtils.clamp(player.y, currentRing.y - halfSize, currentRing.y + halfSize);
    enemy.x = MathUtils.clamp(enemy.x, currentRing.x - halfSize, currentRing.x + halfSize); 
    enemy.y = MathUtils.clamp(enemy.y, currentRing.y - halfSize, currentRing.y + halfSize);

    updateFightHUD();
    updateFloatingText(dt);

    // End of Round Checks
    if (player.hp <= 0) {
        resetRound(false);
    } else if (enemy.hp <= 0) {
        resetRound(true);
    }
}

function updateTransition(dt) {
    player.animTime += dt;
    enemy.animTime += dt;
    updateFloatingText(dt);
}

// --- DRAWING ---
function drawRingShape(ctx, r, isFightingMode) {
    const s = r.size;
    const h = s/2;
    
    ctx.fillStyle = '#6495ED';
    ctx.fillRect(r.x - h, r.y - h, s, s);

    ctx.strokeStyle = 'rgba(0,0,0,0.15)';
    ctx.lineWidth = s * 0.05;
    ctx.strokeRect(r.x - h + (s*0.025), r.y - h + (s*0.025), s - (s*0.05), s - (s*0.05));

    ctx.strokeStyle = '#f1f2f6';
    ctx.lineWidth = 3;
    ctx.strokeRect(r.x - h + 5, r.y - h + 5, s - 10, s - 10);
    ctx.strokeStyle = '#a4b0be';
    ctx.lineWidth = 1;
    ctx.strokeRect(r.x - h + 2, r.y - h + 2, s - 4, s - 4);
    
    const padSize = s * 0.08;
    ctx.fillStyle = '#ff4757'; 
    ctx.fillRect(r.x - h - 5, r.y - h - 5, padSize, padSize);
    ctx.fillRect(r.x + h - padSize + 5, r.y - h - 5, padSize, padSize);
    ctx.fillStyle = '#2ed573'; 
    ctx.fillRect(r.x - h - 5, r.y + h - padSize + 5, padSize, padSize);
    ctx.fillStyle = '#ff4757'; 
    ctx.fillRect(r.x + h - padSize + 5, r.y + h - padSize + 5, padSize, padSize);

    if (!isFightingMode && gameState === 'LOBBY') {
        let entryX = r.x - h + 20;
        let entryY = r.y + h - 20;
        
        ctx.fillStyle = 'rgba(46, 204, 113, 0.3)';
        ctx.fillRect(entryX - 20, entryY - 20, 40, 40);
        
        ctx.fillStyle = '#fff';
        ctx.font = '8px "Press Start 2P"';
        ctx.textAlign = 'center';
        ctx.fillText("ENTER", entryX, entryY - 25);
        
        ctx.font = '12px "Press Start 2P"';
        ctx.fillStyle = '#111';
        ctx.fillText(r.difficulty, r.x, r.y);
        ctx.fillStyle = r.data.color;
        ctx.fillText(r.difficulty, r.x, r.y - 2);

        if (r.entryTimer > 0) {
            ctx.beginPath();
            ctx.arc(player.x, player.y - 40, 12, -Math.PI/2, (-Math.PI/2) + (r.entryTimer / 2) * Math.PI * 2);
            ctx.strokeStyle = '#2ecc71';
            ctx.lineWidth = 5;
            ctx.stroke();
        }
    }
}

function drawGame() {
    if (sprites.floor) {
        const pat = ctx.createPattern(sprites.floor, 'repeat');
        ctx.fillStyle = pat;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    if (gameState === 'LOBBY' || gameState === 'SHOP' || gameState === 'QTE' || gameState === 'FIGHT' || gameState === 'ROUND_TRANSITION') {
        const carpetPat = ctx.createPattern(sprites.carpet, 'repeat');
        ctx.fillStyle = carpetPat;
        ctx.fillRect(0, 100, canvas.width, 48); 
        
        ctx.drawImage(sprites.plant, 40, 110, 24, 24);
        ctx.drawImage(sprites.plant, 836, 110, 24, 24);
        ctx.drawImage(sprites.bag, 120, 100, 24, 24);
        ctx.drawImage(sprites.bag, 756, 100, 24, 24);
    }

    ctx.fillStyle = '#212121';
    ctx.fillRect(0, 0, canvas.width, 100);
    ctx.fillStyle = '#333';
    ctx.fillRect(0, 95, canvas.width, 5);

    // Render Shop NPC & Desk
    ctx.drawImage(sprites.npc, shopZone.x - 15, shopZone.y - 30);
    ctx.drawImage(sprites.desk, shopZone.x - 30, shopZone.y - 12);
    
    ctx.fillStyle = '#fff';
    ctx.font = '8px "Press Start 2P"';
    ctx.textAlign = 'center';
    ctx.fillText("SHOP", shopZone.x, shopZone.y - 35);

    for (let r of rings) {
        if (r !== currentRing) drawRingShape(ctx, r, false);
    }
    
    if (currentRing) {
        let isFightingMode = (gameState === 'QTE' || gameState === 'FIGHT' || gameState === 'ROUND_TRANSITION');
        drawRingShape(ctx, currentRing, isFightingMode);
    }

    if (gameState === 'FIGHT' || gameState === 'QTE' || gameState === 'ROUND_TRANSITION') {
        if (player.y < enemy.y) { player.draw(ctx); enemy.draw(ctx); }
        else { enemy.draw(ctx); player.draw(ctx); }
    } else if (gameState === 'LOBBY' || gameState === 'SHOP') {
        player.draw(ctx);
    }

    drawFloatingText(ctx);
}

function drawQTEOverlay(ctx) {
    ctx.fillStyle = 'rgba(0,0,0,0.6)';
    ctx.fillRect(0,0,canvas.width,canvas.height);
    
    ctx.beginPath();
    ctx.arc(450, 325, 100, 0, Math.PI * 2);
    ctx.strokeStyle = '#222';
    ctx.lineWidth = 15;
    ctx.stroke();

    if (qte.state !== 'WAIT') {
        ctx.beginPath();
        ctx.arc(450, 325, 100, qte.targetStart, qte.targetEnd);
        ctx.strokeStyle = '#2ecc71';
        ctx.lineWidth = 15;
        ctx.stroke();

        ctx.save();
        ctx.translate(450, 325);
        ctx.rotate(qte.angle);
        ctx.beginPath();
        ctx.moveTo(0,0);
        ctx.lineTo(100, 0);
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 4;
        ctx.stroke();
        ctx.restore();
    }

    ctx.fillStyle = '#fff';
    ctx.font = '24px "Press Start 2P"';
    ctx.textAlign = 'center';
    
    if (qte.state === 'SPINNING') {
        ctx.fillText(`PRESS [${qteKeyNames[qte.key]}]`, 450, 180);
    } else if (qte.state === 'HIT') {
        ctx.fillStyle = '#2ecc71';
        ctx.fillText("SUCCESS!", 450, 180);
        ctx.font = '14px "Press Start 2P"';
        ctx.fillText("+10 MAX HP", 450, 210);
    } else if (qte.state === 'MISS') {
        ctx.fillStyle = '#e74c3c';
        ctx.fillText("MISS!", 450, 180);
        ctx.font = '14px "Press Start 2P"';
        ctx.fillText("-10 MAX HP", 450, 210);
    } else if (qte.state === 'WAIT') {
        ctx.fillStyle = '#f1c40f';
        ctx.fillText("GET READY...", 450, 325);
    }
    
    ctx.fillStyle = '#f1c40f';
    ctx.font = '16px "Press Start 2P"';
    ctx.fillText(`WARM-UP: ${qte.round}/3`, 450, 100);
    
    ctx.fillStyle = qte.bonus >= 0 ? '#2ecc71' : '#e74c3c';
    ctx.fillText(`BONUS: ${qte.bonus > 0 ? '+'+qte.bonus : qte.bonus} HP`, 450, 500);
}

// --- EFFECTS ---
function spawnText(x, y, text, color) {
    floatingTexts.push({ x: x, y: y, text: text, color: color, life: 1.0 });
}

function updateFloatingText(dt) {
    for (let i = floatingTexts.length - 1; i >= 0; i--) {
        let t = floatingTexts[i];
        t.y -= 40 * dt; 
        t.life -= dt;
        if (t.life <= 0) floatingTexts.splice(i, 1);
    }
}

function drawFloatingText(ctx) {
    ctx.font = '14px "Press Start 2P"';
    ctx.textAlign = 'center';
    for (let t of floatingTexts) {
        ctx.fillStyle = t.color;
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 4;
        ctx.globalAlpha = Math.max(0, t.life);
        ctx.strokeText(t.text, t.x, t.y);
        ctx.fillText(t.text, t.x, t.y);
    }
    ctx.globalAlpha = 1.0;
}

// --- STATE MANAGEMENT ---
function startGame() {
    screens.start.classList.add('hidden');
    generateRings();
    updatePlayerStats();
    updateDaysUI();
    enterLobby();
}

function startNewRun() {
    screens.over.classList.add('hidden');
    upgrades = { hp: 1, dmg: 1, block: 1 };
    money = 0;
    currentDays = 1;
    uiMoney.innerText = money;
    updateDaysUI();
    
    updatePlayerStats();
    generateRings();
    enterLobby();
}

function enterLobby() {
    gameState = 'LOBBY';
    currentRing = null;
    uiWallet.classList.remove('hidden');
    uiCareer.classList.remove('hidden');
    uiFightHud.classList.add('hidden');
    player.x = 450;
    player.y = 550;
    player.facingAngle = -Math.PI/2; 
    
    player.state = 'IDLE';
    player.actionTimer = 0;
    player.lGloveExt = 0;
    player.rGloveExt = 0;
    player.isBlockBroken = false;
    floatingTexts = [];
}

function initiateFightSequence(ring) {
    currentRing = ring;
    gameState = 'QTE';
    
    playerScore = 0;
    enemyScore = 0;
    document.getElementById('score-player').innerText = playerScore;
    document.getElementById('score-enemy').innerText = enemyScore;

    uiInteract.classList.add('hidden');
    uiWallet.classList.add('hidden');
    uiCareer.classList.add('hidden');
    
    updatePlayerStats();
    
    let eHairs = ['#f1c40f', '#e74c3c', '#2ecc71', '#9b59b6', '#34495e'];
    let eShapes = ['CLASSIC', 'SPIKY', 'AFRO', 'BALD'];
    let eGloves = ['#c0392b', '#2980b9', '#16a085', '#8e44ad', '#f39c12'];
    enemySkin = eHairs[Math.floor(Math.random() * eHairs.length)];
    enemyHairShape = eShapes[Math.floor(Math.random() * eShapes.length)];
    enemyGlove = eGloves[Math.floor(Math.random() * eGloves.length)];
    generateSprites();
    
    player.state = 'IDLE';
    player.actionTimer = 0;
    player.lGloveExt = 0;
    player.rGloveExt = 0;
    enemy.state = 'IDLE';
    enemy.actionTimer = 0;
    enemy.lGloveExt = 0;
    enemy.rGloveExt = 0;

    let h = ring.size / 2 - 30;
    player.x = ring.x - h; 
    player.y = ring.y + h;
    player.facingAngle = -Math.PI/4;

    enemy.maxHp = 100 * ring.data.hpM;
    enemy.hp = enemy.maxHp;
    enemy.baseDmg = 10 * ring.data.dmgM;
    enemy.speed = 150 * ring.data.spdM;
    enemy.maxBlock = 50 * ring.data.hpM;
    enemy.blockHealth = enemy.maxBlock;
    enemy.isBlockBroken = false;
    
    enemy.x = ring.x + h; 
    enemy.y = ring.y - h;
    enemy.facingAngle = Math.PI * 0.75;

    floatingTexts = [];
    
    qte.bonus = 0;
    qte.round = 0;
    qte.state = 'WAIT';
    qte.timer = 1.0;
}

function updateFightHUD() {
    let max = player.fightMaxHp || player.maxHp;
    document.getElementById('p-hp-fill').style.width = Math.max(0, (player.hp / max) * 100) + '%';
    document.getElementById('p-block-fill').style.width = Math.max(0, (player.blockHealth / player.maxBlock) * 100) + '%';
    document.getElementById('p-block-fill').style.background = player.isBlockBroken ? '#ff2a4b' : '#00d2ff';
    document.getElementById('e-hp-fill').style.width = Math.max(0, (enemy.hp / enemy.maxHp) * 100) + '%';
}

function returnToLobby() {
    screens.win.classList.add('hidden');
    floatingTexts = [];
    updatePlayerStats();
    generateRings(); 
    enterLobby();
}

// --- SHOP ---
function openShop() {
    gameState = 'SHOP';
    uiShop.classList.remove('hidden');
    uiInteract.classList.add('hidden');
    switchTab('stats');
}

function closeShop() {
    uiShop.classList.add('hidden');
    gameState = 'LOBBY';
    updatePlayerStats(); 
}

function switchTab(tab) {
    activeTab = tab;
    document.getElementById('tab-stats').classList.add('hidden');
    document.getElementById('tab-hair').classList.add('hidden');
    document.getElementById('tab-gloves').classList.add('hidden');
    document.getElementById('tab-' + tab).classList.remove('hidden');

    document.getElementById('btn-tab-stats').classList.remove('active');
    document.getElementById('btn-tab-hair').classList.remove('active');
    document.getElementById('btn-tab-gloves').classList.remove('active');
    document.getElementById('btn-tab-' + tab).classList.add('active');

    refreshShopUI();
}

function refreshShopUI() {
    if (activeTab === 'stats') {
        ['hp', 'dmg', 'block'].forEach(stat => {
            let lvl = upgrades[stat];
            let cost = baseCosts[stat] * Math.pow(1.5, lvl - 1); 
            cost = Math.floor(cost);
            
            document.getElementById(`stat-${stat}`).innerText = `LVL ${lvl}`;
            document.getElementById(`cost-${stat}`).innerText = `$${cost}`;
            
            let btn = document.getElementById(`btn-${stat}`);
            btn.disabled = money < cost;
        });
    } else if (activeTab === 'hair') {
        let html = '';
        hairShopItems.forEach(item => {
            let id = item.color + item.shape;
            let isOwned = ownedHair.includes(id);
            let isEquipped = (equippedHair === item.color && equippedHairShape === item.shape);
            let btnText = isEquipped ? 'EQUIPPED' : (isOwned ? 'EQUIP' : `$${item.cost}`);
            let disabled = isEquipped || (!isOwned && money < item.cost);
            html += `
            <div class="shop-item">
                <div class="color-preview" style="background:${item.color}; border-radius: ${item.shape === 'CLASSIC' ? '50%' : '10%'};"></div>
                <h3>${item.name}</h3>
                <button onclick="buyHair('${item.color}', '${item.shape}', ${item.cost})" ${disabled ? 'disabled' : ''}>${btnText}</button>
            </div>`;
        });
        document.getElementById('tab-hair').innerHTML = html;
    } else if (activeTab === 'gloves') {
        let html = '';
        gloveShopItems.forEach(item => {
            let isOwned = ownedGloves.includes(item.color);
            let isEquipped = equippedGlove === item.color;
            let btnText = isEquipped ? 'EQUIPPED' : (isOwned ? 'EQUIP' : `$${item.cost}`);
            let disabled = isEquipped || (!isOwned && money < item.cost);
            html += `
            <div class="shop-item">
                <div class="color-preview" style="background:${item.color};"></div>
                <h3>${item.name}</h3>
                <button onclick="buyGlove('${item.color}', ${item.cost})" ${disabled ? 'disabled' : ''}>${btnText}</button>
            </div>`;
        });
        document.getElementById('tab-gloves').innerHTML = html;
    }
}

function buyHair(color, shape, cost) {
    let id = color + shape;
    if (!ownedHair.includes(id)) {
        money -= cost;
        ownedHair.push(id);
        uiMoney.innerText = money;
    }
    equippedHair = color;
    equippedHairShape = shape;
    generateSprites();
    refreshShopUI();
}

function buyGlove(color, cost) {
    if (!ownedGloves.includes(color)) {
        money -= cost;
        ownedGloves.push(color);
        uiMoney.innerText = money;
    }
    equippedGlove = color;
    generateSprites();
    refreshShopUI();
}

function buyUpgrade(stat) {
    let cost = Math.floor(baseCosts[stat] * Math.pow(1.5, upgrades[stat] - 1));
    if (money >= cost) {
        money -= cost;
        upgrades[stat]++;
        uiMoney.innerText = money;
        refreshShopUI();
    }
}

// --- MAIN LOOP ---
function gameLoop(timestamp) {
    if (!lastTime) lastTime = timestamp;
    let dt = (timestamp - lastTime) / 1000;
    lastTime = timestamp;
    
    if (dt > 0.1) dt = 0.1;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (gameState === 'LOBBY') {
        updateLobby(dt);
        drawGame();
    } else if (gameState === 'QTE') {
        updateQTE(dt);
        drawGame(); 
        drawQTEOverlay(ctx);
    } else if (gameState === 'FIGHT') {
        updateFight(dt);
        drawGame();
    } else if (gameState === 'ROUND_TRANSITION') {
        updateTransition(dt);
        drawGame();
    } else if (gameState === 'SHOP') {
        drawGame();
    }

    requestAnimationFrame(gameLoop);
}

requestAnimationFrame(gameLoop);

</script>
