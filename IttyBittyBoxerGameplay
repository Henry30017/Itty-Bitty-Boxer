    </div>

    <!-- Start Screen -->
    <div id="start-screen" class="screen">
        <h1>PIXEL PUNCH-OUT</h1>
        <h2 style="color: #fff; font-size: 16px;">THE LOBBY BRAWL</h2>
        <button onclick="startGame()" style="width: 200px; padding: 20px; font-size: 16px; margin-top: 30px; background: var(--primary); border-color: #ff5271;">ENTER GYM</button>
    </div>

    <!-- Game Over Screen -->
    <div id="game-over-screen" class="screen hidden">
        <h1>GAME OVER</h1>
        <p style="font-size: 12px; margin-bottom: 30px;">Your boxing career has come to an end.</p>
        <button onclick="startNewRun()" style="width: 250px; padding: 15px;">START NEW RUN</button>
    </div>

    <!-- Victory Screen -->
    <div id="win-screen" class="screen hidden">
        <h1 style="color: #00d2ff;">MATCH WON!</h1>
