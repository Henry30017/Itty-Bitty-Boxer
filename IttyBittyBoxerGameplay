                <h3>PUNCH<br>POWER</h3>
                <div class="stat" id="stat-dmg">LVL 1</div>
                <div class="cost" id="cost-dmg">$75</div>
                <button id="btn-dmg" onclick="buyUpgrade('dmg')">UPGRADE</button>
            </div>
            <div class="shop-item">
                <h3>BLOCK<br>STAMINA</h3>
                <div class="stat" id="stat-block">LVL 1</div>
