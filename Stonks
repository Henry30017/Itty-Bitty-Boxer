            { target: 'RANDOM', source: 'Wall Street Journal', headline: 'Surprise Dividend Announced', text: 'A corporate board of directors has surprisingly approved a massive, unexpected dividend payout to shareholders, signaling immense confidence in cash flow.', impact: 1.5, duration: 3 },
