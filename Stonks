        let state = {
            day: 1,
            cash: 10000.00,
            portfolio: {}, 
            history: {},   
            currentPrices: {}, 
            activeEvents: [], 
            newsLog: [],      
            selectedStock: null,
            goal: 1000000000,
            gameOver: false
        };

        let chartInstance = null;
        let unreadNewsCount = 0;

        // Formatting Helpers
        const fmtMoney = (num) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
        const fmtNum = (num) => new Intl.NumberFormat('en-US').format(num);
        const fmtPct = (num) => (num > 0 ? '+' : '') + num.toFixed(2) + '%';

        async function initSystem() {
            if (!Object.keys(firebaseConfig).length) {
                console.warn("No cloud environment detected. Running locally.");
                setupNewGame(true);
                return;
            }

            try {
                app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                if (typeof __initial_auth_token !== 'undefined') {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                userId = auth.currentUser?.uid;
                if (userId) {
                    isFirebaseReady = true;
                    await loadGame();
                } else {
                    setupNewGame(true);
                }
            } catch (error) {
                console.error("Cloud sync initialization failed:", error);
                setupNewGame(true);
            }
        }

        async function saveGame() {
            if (!isFirebaseReady || !userId) return;
            try {
                const saveRef = doc(db, 'artifacts', appId, 'users', userId, 'saves', 'terminalData');
                await setDoc(saveRef, { state, unreadNewsCount });
            } catch (error) {
                console.error("Failed to sync progress to cloud:", error);
            }
        }

        async function loadGame() {
            try {
                const saveRef = doc(db, 'artifacts', appId, 'users', userId, 'saves', 'terminalData');
                const snap = await getDoc(saveRef);
                
                if (snap.exists()) {
                    const data = snap.data();
                    state = data.state;
                    unreadNewsCount = data.unreadNewsCount || 0;
                    setupNewGame(false); // Initialize without resetting data
                    showToast('System Restored', 'Session data synced from cloud.');
                } else {
                    setupNewGame(true); // First time playing
                }
            } catch (error) {
                console.error("Failed to load cloud save:", error);
                setupNewGame(true);
            }
        }

        function setupNewGame(resetData) {
            if (resetData) {
                state.day = 1;
                state.cash = 10000.00;
                state.activeEvents = [];
                state.newsLog = [];
                state.gameOver = false;
                unreadNewsCount = 0;
                
                COMPANIES.forEach(c => {
                    state.portfolio[c.id] = { shares: 0, avgPrice: 0 };
                    state.currentPrices[c.id] = c.basePrice;
                    state.history[c.id] = [];
                    
                    // Pre-fill 30 days of standard history
                    let tempPrice = c.basePrice * 0.8; 
                    for(let i=0; i<30; i++) {
                        state.history[c.id].push(tempPrice);
                        let move = (Math.random() * c.vol * 2) - c.vol;
                        tempPrice = tempPrice * c.drift * (1 + move);
                    }
                    state.currentPrices[c.id] = tempPrice; 
                });

                state.selectedStock = COMPANIES[0].id;
                logNews('System Boot', 'Trading terminal OS v3.1 initialized. Connection to global exchange established. Welcome, Operator. Your goal is 1 Billion USD. Study the intelligence feed carefully to anticipate market shifts.', 'System', true);
            }

            initChart();
            updateUI();
            renderNewsFeed();
        }

        function initChart() {
            if(chartInstance) chartInstance.destroy();
            
            const ctx = document.getElementById('mainChart').getContext('2d');
            Chart.defaults.color = '#94a3b8';
            Chart.defaults.font.family = "'JetBrains Mono', monospace";

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Array.from({length: 30}, (_, i) => `Day -${30-i}`),
                    datasets: [{
                        label: 'Price',
                        data: [],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 2,
                        pointRadius: 0,
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.9)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            borderColor: '#334155',
                            borderWidth: 1,
                            callbacks: {
                                label: function(context) { return fmtMoney(context.parsed.y); }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { color: '#1e293b' } },
                        y: { 
                            grid: { color: '#1e293b' },
                            ticks: { callback: (val) => '$' + val }
                        }
                    }
                }
            });
            updateChartData();
        }

        function advanceDay() {
            if (state.gameOver) return;

            state.day++;

            COMPANIES.forEach(c => {
                let current = state.currentPrices[c.id];
                let movePct = (Math.random() * c.vol * 2) - c.vol;
                
                let eventMultiplier = 1;
                for (let i = state.activeEvents.length - 1; i >= 0; i--) {
                    let ev = state.activeEvents[i];
                    if (ev.target === c.id) {
                        eventMultiplier *= ev.dailyMultiplier;
                        ev.daysLeft--;
                        if (ev.daysLeft <= 0) state.activeEvents.splice(i, 1);
                    }
                }

                let newPrice = current * c.drift * (1 + movePct) * eventMultiplier;
                if (newPrice < 0.05) newPrice = 0.05; 
                
                state.currentPrices[c.id] = newPrice;
                state.history[c.id].push(newPrice);
                
                if (state.history[c.id].length > 60) state.history[c.id].shift();
            });

            // 15% chance per day to get a news event
            if (Math.random() < 0.15) {
                generateNewsEvent();
            }

            updateUI();
            checkWinCondition();
            saveGame(); // Save progress after day ends
        }

        function generateNewsEvent() {
            let template = NEWS_TEMPLATES[Math.floor(Math.random() * NEWS_TEMPLATES.length)];
            let targetId = template.target;
            
            if (targetId === 'RANDOM') {
                targetId = COMPANIES[Math.floor(Math.random() * COMPANIES.length)].id;
            }

            let dailyMulti = Math.pow(template.impact, 1 / template.duration);
            
            state.activeEvents.push({
                target: targetId,
                dailyMultiplier: dailyMulti,
                daysLeft: template.duration
            });

            logNews(template.headline, template.text, template.source);
            showToast('Incoming Intelligence', template.headline);
        }

        function logNews(headline, text, source, isRead = false) {
            const article = {
                id: Date.now() + Math.random(),
                day: state.day,
                headline: headline,
                text: text,
                source: source,
                read: isRead
            };
            state.newsLog.unshift(article);
            if (!isRead) unreadNewsCount++;
            renderNewsFeed();
        }

        function renderNewsFeed() {
            const container = document.getElementById('news-container');
            container.innerHTML = '';
            
            document.getElementById('news-count').textContent = `${unreadNewsCount} New`;
            if(unreadNewsCount > 0) {
                document.getElementById('news-count').classList.replace('bg-blue-900', 'bg-yellow-600');
                document.getElementById('news-count').classList.replace('text-blue-300', 'text-yellow-100');
            } else {
                document.getElementById('news-count').classList.replace('bg-yellow-600', 'bg-blue-900');
                document.getElementById('news-count').classList.replace('text-yellow-100', 'text-blue-300');
            }

            if (state.newsLog.length === 0) return;

            state.newsLog.forEach(article => {
                const item = document.createElement('div');
                item.className = `p-3 bg-slate-900 cursor-pointer text-sm news-item ${article.read ? '' : 'news-unread'}`;
                item.onclick = () => openArticle(article.id);
                
                item.innerHTML = `
                    <div class="flex justify-between items-center mb-1 text-xs text-slate-500">
                        <span class="mono">Day ${article.day}</span>
                        <span>${article.source}</span>
                    </div>
                    <div class="font-semibold ${article.read ? 'text-slate-300' : 'text-white'} truncate">
                        ${article.headline}
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function openArticle(id) {
            const article = state.newsLog.find(a => a.id === id);
            if (!article) return;

            if (!article.read) {
                article.read = true;
                unreadNewsCount = Math.max(0, unreadNewsCount - 1);
                renderNewsFeed();
                saveGame(); // Save read status
            }

            document.getElementById('modal-source').textContent = article.source;
            document.getElementById('modal-headline').textContent = article.headline;
            document.getElementById('modal-date').textContent = `Logged: Day ${article.day}`;
            document.getElementById('modal-body').textContent = article.text;
            document.getElementById('article-modal').classList.remove('hidden');
        }

        function closeArticle() {
            document.getElementById('article-modal').classList.add('hidden');
        }

        function selectStock(id) {
            state.selectedStock = id;
            updateChartData();
            updateTradingPanel();
            
            document.querySelectorAll('.market-row').forEach(row => {
                row.classList.remove('bg-slate-800');
                if (row.dataset.id === id) row.classList.add('bg-slate-800');
            });
        }

        function updateChartData() {
            if (!state.selectedStock || !chartInstance) return;
            
            const comp = COMPANIES.find(c => c.id === state.selectedStock);
            const hist = state.history[state.selectedStock];
            
            document.getElementById('chart-title').innerHTML = `
                <span style="color: ${comp.color};"><i class="fa-solid fa-circle text-xs"></i></span>
                ${comp.name} (${comp.id}) History
            `;

            const labels = hist.map((_, idx) => `Day ${state.day - (hist.length - 1) + idx}`);

            chartInstance.data.labels = labels;
            chartInstance.data.datasets[0].data = hist;
            chartInstance.data.datasets[0].borderColor = comp.color;
            
            const ctx = document.getElementById('mainChart').getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
            
            let hex = comp.color.replace('#', '');
            let r = parseInt(hex.substring(0, 2), 16);
            let g = parseInt(hex.substring(2, 4), 16);
            let b = parseInt(hex.substring(4, 6), 16);
            
            gradient.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0.5)`);
            gradient.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0.0)`);
            
            chartInstance.data.datasets[0].backgroundColor = gradient;
            chartInstance.update();
        }

        function updateTradingPanel() {
            if (!state.selectedStock) {
                document.getElementById('trading-unselected').classList.remove('hidden');
                document.getElementById('trading-selected').classList.add('hidden');
                return;
            }

            document.getElementById('trading-unselected').classList.add('hidden');
            document.getElementById('trading-selected').classList.remove('hidden');
            document.getElementById('trading-selected').classList.add('flex');

            const comp = COMPANIES.find(c => c.id === state.selectedStock);
            const currentPrice = state.currentPrices[state.selectedStock];
            const hist = state.history[state.selectedStock];
            const prevPrice = hist.length > 1 ? hist[hist.length - 2] : currentPrice;
            const change = currentPrice - prevPrice;
            const changePct = (change / prevPrice) * 100;
            const owned = state.portfolio[state.selectedStock].shares;

            document.getElementById('trade-ticker').textContent = comp.id;
            document.getElementById('trade-ticker').style.color = comp.color;
            document.getElementById('trade-name').textContent = comp.name;
            document.getElementById('trade-price').textContent = fmtMoney(currentPrice);
            
            const changeEl = document.getElementById('trade-change');
            changeEl.textContent = fmtPct(changePct);
            changeEl.className = `text-sm font-bold mono ${change >= 0 ? 'stock-up' : 'stock-down'}`;

            document.getElementById('trade-owned').textContent = fmtNum(owned);
            document.getElementById('trade-qty').value = 1;
        }

        function setTradeQty(type) {
            if (!state.selectedStock) return;
            const price = state.currentPrices[state.selectedStock];
            const input = document.getElementById('trade-qty');
            
            if (type === 'max-buy') {
                input.value = Math.floor(state.cash / price);
            } else if (type === 'max-sell') {
                input.value = state.portfolio[state.selectedStock].shares;
            }
        }

        function executeTrade(type) {
            if (!state.selectedStock) return;
            
            const qtyInput = document.getElementById('trade-qty');
            const qty = parseInt(qtyInput.value);
            
            if (isNaN(qty) || qty <= 0) {
                showToast('Trade Error', 'Invalid quantity.', 'error');
                return;
            }

            const compId = state.selectedStock;
            const price = state.currentPrices[compId];
            const cost = price * qty;
            const position = state.portfolio[compId];

            if (type === 'buy') {
                if (state.cash >= cost) {
                    state.cash -= cost;
                    let totalValueOld = position.shares * position.avgPrice;
                    position.shares += qty;
                    position.avgPrice = (totalValueOld + cost) / position.shares;
                    showToast('Execution Confirmed', `BOUGHT ${qty} ${compId} @ ${fmtMoney(price)}`);
                } else {
                    showToast('Trade Error', 'Insufficient cash available.', 'error');
                    return; // exit early, no save needed
                }
            } else if (type === 'sell') {
                if (position.shares >= qty) {
                    state.cash += cost;
                    position.shares -= qty;
                    if(position.shares === 0) position.avgPrice = 0; 
                    showToast('Execution Confirmed', `SOLD ${qty} ${compId} @ ${fmtMoney(price)}`);
                } else {
                    showToast('Trade Error', 'Insufficient shares to sell.', 'error');
                    return; // exit early, no save needed
                }
            }

            updateUI();
            saveGame(); // Save portfolio status
        }

        function updateUI() {
            document.getElementById('date-display').textContent = `Day ${state.day} | Year ${Math.floor((state.day-1)/365) + 1}`;
            document.getElementById('header-cash').textContent = fmtMoney(state.cash);
            
            let portfolioValue = 0;
            COMPANIES.forEach(c => {
                portfolioValue += state.portfolio[c.id].shares * state.currentPrices[c.id];
            });
            let netWorth = state.cash + portfolioValue;
            document.getElementById('header-nw').textContent = fmtMoney(netWorth);

            let pct = (netWorth / state.goal) * 100;
            document.getElementById('goal-pct').textContent = pct.toFixed(4) + '%';
            document.getElementById('goal-bar').style.width = Math.min(100, pct) + '%';

            const tbody = document.getElementById('market-list');
            tbody.innerHTML = '';

            COMPANIES.forEach(comp => {
                const currentPrice = state.currentPrices[comp.id];
                const hist = state.history[comp.id];
                const prevPrice = hist.length > 1 ? hist[hist.length - 2] : currentPrice;
                const change = currentPrice - prevPrice;
                const changePct = (change / prevPrice) * 100;
                const isUp = change >= 0;
                const owned = state.portfolio[comp.id].shares;
                const val = owned * currentPrice;

                const tr = document.createElement('tr');
                tr.className = `market-row border-b border-slate-700/50 hover:bg-slate-800/50 cursor-pointer transition-colors ${state.selectedStock === comp.id ? 'bg-slate-800' : ''}`;
                tr.dataset.id = comp.id;
                tr.onclick = () => selectStock(comp.id);

                tr.innerHTML = `
                    <td class="p-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full" style="background-color: ${comp.color}"></span>
                            <div>
                                <div class="font-bold mono text-white">${comp.id}</div>
                                <div class="text-xs text-slate-500 truncate w-24 md:w-auto">${comp.name}</div>
                            </div>
                        </div>
                    </td>
                    <td class="p-3 text-right font-mono">${fmtMoney(currentPrice)}</td>
                    <td class="p-3 text-right font-mono ${isUp ? 'stock-up' : 'stock-down'}">${fmtPct(changePct)}</td>
                    <td class="p-3 text-right font-mono text-slate-300">${fmtNum(owned)}</td>
                    <td class="p-3 text-right font-mono text-white">${fmtMoney(val)}</td>
                    <td class="p-3 text-center">
                        <button class="text-slate-400 hover:text-blue-400"><i class="fa-solid fa-crosshairs"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            if (state.selectedStock) {
                updateChartData();
                updateTradingPanel();
            }
        }

        let toastTimeout;
        function showToast(title, msg, type = 'info') {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').textContent = title;
            document.getElementById('toast-msg').textContent = msg;
            const icon = document.getElementById('toast-icon');
            
            if (type === 'error') {
                toast.classList.replace('border-blue-500', 'border-rose-500');
                icon.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-500"></i>';
            } else {
                 toast.classList.replace('border-rose-500', 'border-blue-500');
                 icon.innerHTML = '<i class="fa-solid fa-circle-info text-blue-500"></i>';
            }

            toast.classList.remove('translate-y-full', 'opacity-0');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-full', 'opacity-0');
            }, 3000);
        }

        function checkWinCondition() {
            let portfolioValue = 0;
            COMPANIES.forEach(c => {
                portfolioValue += state.portfolio[c.id].shares * state.currentPrices[c.id];
            });
            let netWorth = state.cash + portfolioValue;

            if (netWorth >= state.goal && !state.gameOver) {
                state.gameOver = true;
                document.getElementById('win-days').textContent = state.day;
                document.getElementById('win-nw-text').textContent = fmtMoney(netWorth);
                document.getElementById('victory-modal').classList.remove('hidden');
                saveGame(); // Save victory state
            }
        }

        // Bind functions to window so HTML inline onclick events can access them within the module scope
        window.advanceDay = advanceDay;
        window.setTradeQty = setTradeQty;
        window.executeTrade = executeTrade;
        window.closeArticle = closeArticle;

        // Start App
        window.onload = initSystem;

    </script>
</body>
</html>
