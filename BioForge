            // --- MULTIPLAYER MARKET LOGIC ---
            async switchMarketTab(tab) {
                this.marketTab = tab;
                document.getElementById('market-buy-view').classList.toggle('hidden', tab !== 'buy');
                document.getElementById('market-sell-view').classList.toggle('hidden', tab !== 'sell');
                document.getElementById('tab-buy').style.opacity = tab === 'buy' ? '1' : '0.4';
                document.getElementById('tab-sell').style.opacity = tab === 'sell' ? '1' : '0.4';
                
                const searchBar = document.getElementById('market-search');
                if (searchBar) {
                    searchBar.style.display = tab === 'buy' ? 'block' : 'none';
                    if (tab === 'buy') searchBar.value = '';
                }


                if (tab === 'buy') {
                    await this.loadMarketBuy();
                } else {
                    this.renderMarketSell();
                }
            },


            filterMarket(query) {
                if (!query) query = '';
                query = query.toLowerCase();
                const items = document.querySelectorAll('.market-item-card');
                items.forEach(el => {
                    const name = el.getAttribute('data-name');
                    if (name && name.includes(query)) {
                        el.style.display = 'flex';
                    } else {
                        el.style.display = 'none';
                    }
                });
            },


            async loadMarketBuy() {
                const grid = document.getElementById('market-stock-grid');
                grid.innerHTML = '<div class="col-span-full text-center py-10 text-slate-500 font-bold">Loading global market...</div>';
                
                const { data, error } = await supabase
                    .from('market_listings')
                    .select('*')
                    .order('created_at', { ascending: false });
                
                if (error) {
                    console.error("Supabase Error:", error);
                    grid.innerHTML = '<div class="col-span-full text-center py-10 text-red-500 font-bold">Failed to load market. Please try again.</div>';
                    return;
                }


                grid.innerHTML = '';
                
                const otherListings = data.filter(item => item.seller_id !== this.playerId);


                if (otherListings.length === 0) {
                    grid.innerHTML = '<div class="col-span-full text-center py-10 text-slate-500 italic">No items listed by other players.</div>';
                    return;
                }


                otherListings.forEach(item => {
                    const obj = item.animal_data;
                    const category = obj.marketCategory || (obj.type === 'mutation' ? 'mutation' : 'animal');
                    const currency = obj.marketCurrency || 'dollars';
                    const isMutation = category === 'mutation';
                    const isPotion = category === 'potion';
                    
                    const searchName = isPotion ? obj.name : (isMutation ? obj.name + ' Orb' : obj.mutation.name + ' ' + obj.name);
                    
                    const div = document.createElement('div');
                    let rarityClass = '';
                    if (isPotion) {
                        rarityClass = obj.type === 'luck' ? 'text-indigo-400' : 'text-emerald-400';
                    } else {
                        rarityClass = `rarity-${obj.rarity ? obj.rarity.toLowerCase() : obj.mutation.rarity.toLowerCase()}`;
                    }
                    
                    div.className = "market-item-card bg-slate-800 p-4 rounded-xl border border-slate-700 hover:border-amber-500 transition-colors flex flex-col justify-between";
                    div.setAttribute('data-name', searchName.toLowerCase());
                    
                    div.innerHTML = `
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-3xl ${isMutation ? 'orb-glow drop-shadow-lg ' + rarityClass : ''}">${isPotion ? '🧪' : (isMutation ? '🔮' : obj.emoji)}</span>
                                <div class="flex flex-col items-end">
                                    <div class="flex items-center gap-1">
                                        ${obj.isFermented && !isPotion ? '<span class="text-[10px]">🦠</span>' : ''}
