                    if (this.lootEggTickets === undefined) this.lootEggTickets = 0;
                    if (this.lastEasterEggTime === undefined) this.lastEasterEggTime = 0;
                    if (!this.activeBoosts) this.activeBoosts = { luck: { mult: 1, timer: 0 }, profit: { mult: 1, timer: 0 } };
                    
