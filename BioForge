                        </div>
                        <div>
                            <p class="text-emerald-400 font-mono font-bold text-lg mb-3 mt-2">${this.formatCurrencyDisplay(item.price, currency)}</p>
                            <button onclick="gameState.buyFromMarket('${item.id}', ${item.price}, '${currency}')" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-xs font-bold transition-all shadow-lg active:scale-95">PURCHASE</button>
