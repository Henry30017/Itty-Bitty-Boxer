            getSpeciesTable() {
                const luckLvl = this.upgrades.luck.level || 1;
                const tier = this.selectedEggTier || 0;
                const baseLuckMult = 1 + (luckLvl - 1) * 0.15;
                const eggLuck = EGG_TIERS[tier].luck;
                const potionLuck = this.activeBoosts.luck.mult || 1;
                const totalLuck = baseLuckMult * eggLuck * potionLuck;
                
                let table = [];
                
                // Standard scaling for all pets based on luck
                let modifiedWeights = SPECIES.map((s, i) => {
                    let power = i / SPECIES.length; 
                    return s.weight * Math.pow(totalLuck, power * 2.0);
                });
                
                let sumModified = modifiedWeights.reduce((a, b) => a + b, 0);
                
                SPECIES.forEach((s, i) => {
                    table.push({
                        species: s,
                        chance: modifiedWeights[i] / sumModified
                    });
                });
                
                // Manual overrides for the absolute top tiers to ensure strict descending rarity
                let dinoIdx = SPECIES.findIndex(s => s.name === "Dinosaur");
                let rgIdx = SPECIES.findIndex(s => s.name === "Reality Glitch");
                let angelIdx = SPECIES.findIndex(s => s.name === "Angel");
                let dogIdx = SPECIES.findIndex(s => s.name === "Dog");
                
                if (dinoIdx > -1 && rgIdx > -1 && angelIdx > -1 && dogIdx > -1) {
                    let dinoChance = table[dinoIdx].chance;
                    
                    // User constraint: Reality Glitch reaches ~1% max at luck 100, +0.2% per tier
                    let requestedRgMax = (luckLvl / 100) * 0.01 + (tier * 0.002);
                    
                    // MUST be strictly rarer than Dinosaur to prevent the "chances going up" glitch
                    let rgChance = Math.min(dinoChance * 0.5, requestedRgMax);
                    
                    // Enforce an absolute minimum so it's always mathematically possible
                    rgChance = Math.max(0.00000005, rgChance); 
                    
                    let angelChance = rgChance * 0.2;
                    let dogChance = angelChance * 0.2;
                    
                    let fixedSum = rgChance + angelChance + dogChance;
                    let originalTopSum = table[rgIdx].chance + table[angelIdx].chance + table[dogIdx].chance;
                    let scale = (1 - fixedSum) / (1 - originalTopSum);
                    
                    for(let i = 0; i <= dinoIdx; i++) {
                        table[i].chance *= scale;
                    }
                    
                    table[rgIdx].chance = rgChance;
                    table[angelIdx].chance = angelChance;
                    table[dogIdx].chance = dogChance;
                }
                
                return table;
            },


            generateAnimal(luck) {
                const speciesTable = this.getSpeciesTable();
                let rW = Math.random();
                let spec = speciesTable[0].species;
                
                for (let entry of speciesTable) {
                    if (rW < entry.chance) { spec = entry.species; break; }
                    rW -= entry.chance;
                }
                
                let mut = MUTATIONS[0];
                for (let m of [...MUTATIONS].reverse()) {
                    if (m.id !== 'normal' && Math.random() < (m.chance * luck)) { mut = m; break; }
                }


                this.animals.push({ id: crypto.randomUUID(), ...spec, mutation: mut, level: 0, exp: 0, acquiredAt: Date.now() });
                
                if (!this.discoveredMutations.includes(mut.id)) {
                    this.discoveredMutations.push(mut.id);
                    const profitMult = this.activeBoosts.profit.mult || 1;
                    this.money += (mut.reward * profitMult);
                    document.getElementById('journal-notif').classList.remove('hidden');
                    this.updateJournal();
                }
                this.updateUI();
            },


            doMaintenance(type) {
                const m = this.maintenance[type];
                if (m.cooldown > 0) return;
                const profitMult = this.activeBoosts.profit.mult || 1;
                this.money += Math.floor(m.pay * (1 + (this.upgrades.maint.level - 1) * 0.25)) * profitMult;
                m.cooldown = m.max;
                this.updateMaintenanceUI(type);
            },


            updateMaintenanceUI(type) {
                const m = this.maintenance[type];
                const pct = (m.cooldown / m.max) * 100;
                document.getElementById(`cooldown-${type}`).style.height = pct + '%';
                document.getElementById(`text-${type}`).innerText = m.cooldown > 0 ? m.cooldown + 's' : 'Ready';
            },


            updateJournal() {
                const list = document.getElementById('journal-list');
                if (!list) return;
                list.innerHTML = '';
                MUTATIONS.forEach(mut => {
                    const discovered = this.discoveredMutations.includes(mut.id);
                    list.innerHTML += `<div class="p-4 rounded-xl border ${discovered ? 'bg-slate-800 border-slate-700' : 'bg-slate-900 opacity-40'}">
                        <div class="flex justify-between"><span class="text-xs font-bold">${mut.name}</span><span class="text-[8px] rarity-${mut.rarity.toLowerCase()}">${mut.rarity}</span></div>
                    </div>`;
                });
            },


            sortByRarity() { this.animals.sort((a, b) => RARITY_LEVELS[b.mutation.rarity] - RARITY_LEVELS[a.mutation.rarity]); this.updateUI(); },


            showToast(msg, type="info") {
                const t = document.createElement('div');
                t.className = `bg-slate-800 text-white px-4 py-2 rounded-lg border border-slate-700 text-xs font-bold animate-bounce z-[200]`;
                if(type === "success") t.classList.add('border-emerald-500');
                if(type === "error") t.classList.add('border-red-500');
                if(type === "special") t.classList.add('border-purple-500');
                t.innerText = msg;
                document.getElementById('toast-container').appendChild(t);
                setTimeout(() => t.remove(), 3000);
            },


            setupListeners() {
                // Bulletproof helper so a single missing element never crashes the game
                const addClick = (id, fn) => { const el = document.getElementById(id); if (el) el.onclick = fn; };
                
                addClick('hatch-btn', () => this.hatchEgg());
                addClick('upg-luck', () => this.upgrade('luck'));
                addClick('upg-profit', () => this.upgrade('profit'));
                addClick('upg-maint', () => this.upgrade('maint'));
                addClick('upg-pop', () => this.upgrade('pop'));
                
                // Lab buttons
                addClick('lab-extract-btn', () => this.doExtract());
                addClick('lab-breed-btn', () => this.doBreed());
                addClick('lab-transfer-btn', () => this.doTransfer());
                
                // Modals
                addClick('open-journal', () => { this.openModal('journal-modal'); document.getElementById('journal-notif').classList.add('hidden'); });
                addClick('close-journal', () => this.closeModal('journal-modal'));
                addClick('open-market', () => { this.openModal('market-modal'); document.getElementById('market-notif').classList.add('hidden'); this.switchMarketTab('buy'); });
                addClick('close-market', () => this.closeModal('market-modal')); // Fails safely if missing now
                addClick('open-cryo', () => this.openCryo());
                addClick('close-cryo', () => this.closeModal('cryo-modal'));
                addClick('close-detail', () => { this.closeModal('detail-modal'); this.currentlyViewingAnimal = null; });
                
                // Billion egg button
                addClick('egg-tier-4', () => this.openBillionDollarEgg());


                EGG_TIERS.forEach(t => {
                    addClick(`egg-tier-${t.id}`, () => {
                        this.selectedEggTier = t.id;
                        document.querySelectorAll('.egg-selector button').forEach(b => b.classList.remove('active'));
                        const btn = document.getElementById(`egg-tier-${t.id}`);
                        if (btn) btn.classList.add('active');
                        const hatchBtn = document.getElementById('hatch-btn');
                        if (hatchBtn) hatchBtn.innerText = `BUY EGG ($${t.cost.toLocaleString()})`;
                    });
                });
            }
        };


        // Run immediately to ensure everything loads flawlessly
        gameState.init();
    </script>
</body>
</html>



