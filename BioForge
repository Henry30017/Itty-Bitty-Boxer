            async cancelListing(listingId) {
                const { error } = await supabase
                    .from('market_listings')
                    .delete()
                    .eq('id', listingId)
                    .eq('seller_id', this.playerId);


                if (error) {
                    this.showToast("Failed to remove listing from server.", "error");
                    return;
                }


                const listIdx = this.activeListings.findIndex(l => l.id == listingId);
                if (listIdx > -1) {
                    const listing = this.activeListings.splice(listIdx, 1)[0];
                    const category = listing.animal.marketCategory || (listing.animal.type === 'mutation' ? 'mutation' : 'animal');
                    
                    if (category === 'mutation') {
                        this.extractedMutations.push(listing.animal);
                    } else if (category === 'potion') {
                        this.potions.push(listing.animal);
                    } else {
                        this.animals.push(listing.animal);
                    }
                    this.showToast("Listing cancelled. Item returned.", "info");
                }
                
                this.renderMarketSell();
                this.updateUI();
            },


            async checkSoldListings() {
                if (!this.activeListings || this.activeListings.length === 0) return;
                
                const { data, error } = await supabase
                    .from('market_listings')
                    .select('id')
                    .eq('seller_id', this.playerId);
                    
                if (error || !data) return;
                const activeIdsOnServer = data.map(d => d.id);
                
                const profitMult = this.activeBoosts.profit.mult || 1;
                
                for (let i = this.activeListings.length - 1; i >= 0; i--) {
                    const listing = this.activeListings[i];
                    if (!activeIdsOnServer.includes(listing.id)) {
                        let earned = listing.price;
                        let currencyType = listing.animal.marketCurrency || 'dollars';
                        let displayMsg = '';


                        if (currencyType === 'dollars') {
                            earned *= profitMult;
                            this.money += earned;
                            displayMsg = `$${earned.toLocaleString()}`;
                        } else if (currencyType === 'extraction_tokens') {
                            this.extractionTokens += earned;
                            displayMsg = `${earned} Extraction Token(s)`;
                        } else if (currencyType === 'reward_tokens') {
                            this.freeSpins += earned;
                            displayMsg = `${earned} Reward Token(s)`;
                        } else if (currencyType === 'loot_egg_tickets') {
                            this.lootEggTickets += earned;
                            displayMsg = `${earned} Loot Egg Ticket(s)`;
                        }


                        const category = listing.animal.marketCategory || (listing.animal.type === 'mutation' ? 'mutation' : 'animal');
                        
                        let name = listing.animal.name;
                        if (category === 'mutation') name = `[P. lvl ${listing.animal.purity || 0}] ${name} Orb`;
                        else if (category === 'potion') name = `[Potion] ${name}`;
                        else name = `[P. lvl ${listing.animal.purity || 0}] ${name}`;
                        
                        this.showToast("Your listing was purchased!", "success");
                        this.showToast(`Earned ${displayMsg}!`, "success");
                        this.activeListings.splice(i, 1);
                    }
                }
                
                if (this.marketTab === 'sell' && !document.getElementById('market-modal').classList.contains('hidden')) {
                    this.renderMarketSell();
