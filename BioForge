<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bioforge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');
       
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f1f5f9;
            overflow-x: hidden;
        }

        .animal-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: linear-gradient(145deg, #1e293b, #0f172a);
            border: 1px solid #334155;
            position: relative;
        }

        .animal-card:hover {
            transform: translateY(-5px);
            border-color: #6366f1;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .rarity-normal { color: #cbd5e1; }
        .rarity-common { color: #94a3b8; }
        .rarity-uncommon { color: #4ade80; text-shadow: 0 0 10px rgba(74, 222, 128, 0.3); }
        .rarity-rare { color: #60a5fa; text-shadow: 0 0 10px rgba(96, 165, 250, 0.3); }
        .rarity-epic { color: #c084fc; text-shadow: 0 0 10px rgba(192, 132, 252, 0.3); }
        .rarity-mythical { color: #fb7185; text-shadow: 0 0 15px rgba(251, 113, 133, 0.5); font-weight: bold; }
        .rarity-godly { color: #facc15; text-shadow: 0 0 20px rgba(250, 204, 21, 0.7); font-weight: 900; animation: pulse 2s infinite; }
        .rarity-ascendant { color: #22d3ee; text-shadow: 0 0 25px rgba(34, 211, 238, 0.8); font-weight: 900; }
        .rarity-omni { color: #ffffff; text-shadow: 0 0 30px #fff, 0 0 50px #6366f1; font-weight: 900; animation: rainbow-glow 3s linear infinite; }

        @keyframes rainbow-glow {
            0% { filter: hue-rotate(0deg); }
            100% { filter: hue-rotate(360deg); }
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.7; }
            100% { opacity: 1; }
        }

        .progress-bar { transition: width 0.1s linear; }
        .cooldown-bar { transition: height 0.3s linear; }
        .floating { animation: floating 3s ease-in-out infinite; }

        @keyframes floating {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }

        .modal-backdrop {
            background-color: rgba(0,0,0,0.8);
            backdrop-filter: blur(4px);
        }

        .egg-selector button.active {
            border-color: #6366f1;
            background-color: rgba(99, 102, 241, 0.2);
            transform: scale(1.05);
        }

        .warborn-glint {
            box-shadow: 0 0 15px #ff4757;
            border-color: #ff4757 !important;
        }

        .chat-bubble {
            position: relative;
            background: #1e293b;
            border-radius: 1rem;
            padding: 1rem;
            max-width: 90%;
            border: 1px solid #334155;
        }
    </style>
</head>
<body class="p-4 md:p-8">
    <div class="max-w-[1600px] mx-auto">
        <header class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4 bg-slate-800/50 p-6 rounded-2xl border border-slate-700 shadow-xl">
            <div class="flex items-center gap-4">
                <div>
                    <h1 class="text-3xl font-extrabold text-white tracking-tight">Bio <span class="text-indigo-500">Forge</span> </h1>
                    <p class="text-slate-400">Discover species and negotiate with buyers!</p>
                </div>
            </div>
            <div class="flex gap-2 md:gap-4 items-center">
                <button id="open-market" class="p-3 bg-amber-900/50 hover:bg-amber-800 rounded-xl transition-all border border-amber-500/30 relative" title="Global Market">
                    <span class="text-2xl">🏪</span>
                    <div id="market-notif" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-blue-500 rounded-full border-2 border-slate-800"></div>
                </button>
                <button id="open-cryo" class="p-3 bg-cyan-900/50 hover:bg-cyan-800 rounded-xl transition-all border border-cyan-500/30" title="Cryogenic Chamber">
                    <span class="text-2xl">🌵</span>
                </button>
                <button id="open-journal" class="p-3 bg-slate-700 hover:bg-slate-600 rounded-xl transition-all relative" title="Mutation Journal">
                    <span class="text-2xl">📖</span>
                    <div id="journal-notif" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full border-2 border-slate-800"></div>
                </button>
                <div class="h-10 w-px bg-slate-700"></div>
                <div class="text-right">
                    <p class="text-xs uppercase tracking-widest text-slate-500 font-bold">Total Budget</p>
                    <p id="money-display" class="text-2xl font-mono font-bold text-emerald-400">$250</p>
                    <p id="income-display" class="text-[10px] font-mono text-emerald-500/80">+$0/s</p>
                </div>
                <div class="h-10 w-px bg-slate-700"></div>
                <div class="text-right">
                    <p class="text-xs uppercase tracking-widest text-slate-500 font-bold">Zoo Pop.</p>
                    <p id="pop-display" class="text-2xl font-mono font-bold text-indigo-400">0/24</p>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
            <!-- 1. INCUBATOR -->
            <div class="lg:col-span-3 space-y-6">
                <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700 h-full">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2"><span>🥚</span> 1. Incubator</h2>
                    <div class="egg-selector grid grid-cols-2 gap-2 mb-4">
                        <button id="egg-tier-0" class="active flex flex-col items-center p-2 rounded-lg border-2 border-slate-700 bg-slate-900 transition-all">
                            <span class="text-xl">🥚</span>
                            <span class="text-[10px] font-bold uppercase mt-1">Standard</span>
                            <span class="text-[9px] text-slate-400">$100</span>
                        </button>
                        <button id="egg-tier-1" class="flex flex-col items-center p-2 rounded-lg border-2 border-slate-700 bg-slate-900 transition-all">
                            <span class="text-xl">✨</span>
                            <span class="text-[10px] font-bold uppercase mt-1">Great</span>
                            <span class="text-[9px] text-slate-400">$1,500</span>
                        </button>
                        <button id="egg-tier-2" class="flex flex-col items-center p-2 rounded-lg border-2 border-slate-700 bg-slate-900 transition-all">
                            <span class="text-xl">💎</span>
                            <span class="text-[10px] font-bold uppercase mt-1">Ultra</span>
                            <span class="text-[9px] text-slate-400">$8,500</span>
                        </button>
                        <button id="egg-tier-3" class="flex flex-col items-center p-2 rounded-lg border-2 border-slate-700 bg-slate-900 transition-all">
                            <span class="text-xl">🌌</span>
                            <span class="text-[10px] font-bold uppercase mt-1">Omega</span>
                            <span class="text-[9px] text-slate-400">$30,000</span>
                        </button>
                    </div>
                    <div id="hatch-zone" class="relative bg-slate-900 rounded-xl aspect-square flex items-center justify-center overflow-hidden border-2 border-dashed border-slate-700 mb-4">
                        <div id="egg-container" class="text-8xl floating cursor-pointer select-none">🥚</div>
                        <div id="hatch-overlay" class="hidden absolute inset-0 bg-indigo-600/20 flex items-center justify-center backdrop-blur-sm">
                            <div class="text-center">
                                <div class="text-2xl font-bold mb-2 text-white">HATCHING...</div>
                                <div class="w-40 h-2 bg-slate-800 rounded-full overflow-hidden mx-auto">
                                    <div id="hatch-progress" class="progress-bar h-full bg-white w-0"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button id="hatch-btn" class="w-full py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl transition-colors shadow-lg active:scale-95">BUY EGG ($100)</button>
                </div>
            </div>

            <!-- 2. HABITATS -->
            <div class="lg:col-span-4">
                <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700 h-full flex flex-col">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold flex items-center gap-2"><span>🏡</span> 2. Habitats</h2>
                        <button onclick="gameState.sortByRarity()" class="px-3 py-1 bg-slate-700 hover:bg-slate-600 rounded text-[10px] uppercase font-bold transition-colors">Sort</button>
                    </div>
                    <div id="inventory-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 overflow-y-auto max-h-[700px] pr-2"></div>
                    <div id="empty-state" class="flex-1 flex flex-col items-center justify-center text-slate-500 italic py-20">
                        <span class="text-4xl mb-2">🏜️</span> No animals yet.
                    </div>
                </div>
            </div>

            <!-- 3. GENE LAB & UPGRADES -->
            <div class="lg:col-span-3 space-y-6">
                <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
                    <h2 class="text-xl font-bold flex items-center gap-2 mb-4"><span>🧬</span> 3. Gene Lab</h2>
                    <div class="grid grid-cols-2 gap-2 mb-4 bg-slate-900 p-3 rounded-xl border border-slate-700">
                        <div class="flex flex-col items-center">
                            <div id="parent-1" class="w-16 h-16 bg-slate-800 rounded-lg flex flex-col items-center justify-center border border-slate-700 shadow-inner relative overflow-hidden">
                                <span class="emoji text-3xl">?</span>
                                <span class="mut-tag text-[7px] font-bold absolute bottom-1 px-1 bg-black/50 rounded truncate w-full text-center"></span>
                            </div>
                            <span class="text-[9px] text-slate-500 mt-1 uppercase font-bold">Source</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <div id="parent-2" class="w-16 h-16 bg-slate-800 rounded-lg flex flex-col items-center justify-center border border-slate-700 shadow-inner relative overflow-hidden">
                                <span class="emoji text-3xl">?</span>
                                <span class="mut-tag text-[7px] font-bold absolute bottom-1 px-1 bg-black/50 rounded truncate w-full text-center"></span>
                            </div>
                            <span class="text-[9px] text-slate-500 mt-1 uppercase font-bold">Target</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 gap-2">
                        <button id="lab-breed-btn" disabled class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 disabled:bg-slate-700 disabled:text-slate-500 text-white text-xs font-bold rounded-lg transition-colors shadow-lg">HYBRID BREED ($500)</button>
                        <button id="lab-transfer-btn" disabled class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 disabled:bg-slate-700 disabled:text-slate-500 text-white text-xs font-bold rounded-lg transition-colors shadow-lg">TRANSFER GENE ($2,500)</button>
                    </div>
                </div>

                <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
                    <h2 class="text-xl font-bold mb-4 flex items-center gap-2"><span>🚀</span> 4. Upgrades</h2>
                    <div class="space-y-3">
                        <button id="upg-luck" class="w-full flex justify-between items-center p-3 bg-slate-900 rounded-xl border border-slate-700 hover:border-indigo-500 transition-all">
                            <div class="text-left"><p class="text-xs font-bold uppercase text-indigo-400">Luck</p><p id="luck-level" class="text-[10px] text-slate-500">Lv. 1</p></div>
                            <p id="luck-cost" class="text-sm font-mono font-bold text-emerald-400">$300</p>
                        </button>
                        <button id="upg-profit" class="w-full flex justify-between items-center p-3 bg-slate-900 rounded-xl border border-slate-700 hover:border-emerald-500 transition-all">
                            <div class="text-left"><p class="text-xs font-bold uppercase text-emerald-400">Profit</p><p id="profit-level" class="text-[10px] text-slate-500">Lv. 1</p></div>
                            <p id="profit-cost" class="text-sm font-mono font-bold text-emerald-400">$500</p>
                        </button>
                        <button id="upg-maint" class="w-full flex justify-between items-center p-3 bg-slate-900 rounded-xl border border-slate-700 hover:border-yellow-500 transition-all">
                            <div class="text-left"><p class="text-xs font-bold uppercase text-yellow-400">Maintenance</p><p id="maint-level" class="text-[10px] text-slate-500">Lv. 1</p></div>
                            <p id="maint-cost" class="text-sm font-mono font-bold text-emerald-400">$200</p>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 5. SIDE MAINTENANCE -->
            <div class="lg:col-span-2 space-y-4">
                <div class="bg-slate-800/50 p-4 rounded-2xl border border-slate-700">
                    <h2 class="text-sm font-bold mb-2 flex items-center gap-2"><span>💩</span> Scoop</h2>
                    <div class="relative w-full h-20 bg-slate-900 rounded-lg overflow-hidden border border-slate-700">
                        <div id="cooldown-scoop" class="cooldown-bar absolute bottom-0 left-0 w-full bg-emerald-600/20"></div>
                        <button onclick="gameState.doMaintenance('scoop')" id="btn-scoop" class="absolute inset-0 w-full h-full text-white flex flex-col items-center justify-center gap-1 hover:bg-emerald-500/10 transition-colors">
                            <span class="text-2xl">💩</span>
                            <span id="text-scoop" class="text-[10px] font-bold uppercase">Ready</span>
                        </button>
                    </div>
                </div>
                <div class="bg-slate-800/50 p-4 rounded-2xl border border-slate-700">
                    <h2 class="text-sm font-bold mb-2 flex items-center gap-2"><span>🥬</span> Feed</h2>
                    <div class="relative w-full h-20 bg-slate-900 rounded-lg overflow-hidden border border-slate-700">
                        <div id="cooldown-feed" class="cooldown-bar absolute bottom-0 left-0 w-full bg-blue-600/20"></div>
                        <button onclick="gameState.doMaintenance('feed')" id="btn-feed" class="absolute inset-0 w-full h-full text-white flex flex-col items-center justify-center gap-1 hover:bg-blue-500/10 transition-colors">
                            <span class="text-2xl">🥬</span>
                            <span id="text-feed" class="text-[10px] font-bold uppercase">Ready</span>
                        </button>
                    </div>
                </div>
                <div class="bg-slate-800/50 p-4 rounded-2xl border border-slate-700">
                    <h2 class="text-sm font-bold mb-2 flex items-center gap-2"><span>🖐️</span> Pet</h2>
                    <div class="relative w-full h-20 bg-slate-900 rounded-lg overflow-hidden border border-slate-700">
                        <div id="cooldown-pet" class="cooldown-bar absolute bottom-0 left-0 w-full bg-pink-600/20"></div>
                        <button onclick="gameState.doMaintenance('pet')" id="btn-pet" class="absolute inset-0 w-full h-full text-white flex flex-col items-center justify-center gap-1 hover:bg-pink-500/10 transition-colors">
                            <span class="text-2xl">🖐️</span>
                            <span id="text-pet" class="text-[10px] font-bold uppercase">Ready</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODALS -->
    <div id="journal-modal" class="fixed inset-0 z-[60] flex items-center justify-center p-4 hidden">
        <div class="modal-backdrop absolute inset-0"></div>
        <div class="bg-slate-900 border border-slate-700 rounded-3xl w-full max-w-4xl max-h-[85vh] overflow-hidden relative shadow-2xl flex flex-col">
            <div class="p-6 border-b border-slate-800 flex justify-between items-center">
                <h2 class="text-2xl font-bold flex items-center gap-2"><span class="text-indigo-400">📖</span> Mutation Journal</h2>
                <button id="close-journal" class="text-slate-500 hover:text-white text-2xl">&times;</button>
            </div>
            <div class="p-6 overflow-y-auto">
                <div id="journal-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
            </div>
        </div>
    </div>

    <div id="detail-modal" class="fixed inset-0 z-[70] flex items-center justify-center p-4 hidden">
        <div class="modal-backdrop absolute inset-0"></div>
        <div class="bg-slate-900 border border-slate-700 rounded-3xl w-full max-w-md overflow-hidden relative shadow-2xl flex flex-col">
            <div id="detail-content" class="p-8 flex flex-col items-center text-center"></div>
            <button id="close-detail" class="absolute top-4 right-4 text-slate-500 hover:text-white text-2xl">&times;</button>
        </div>
    </div>

    <div id="cryo-modal" class="fixed inset-0 z-[60] flex items-center justify-center p-4 hidden">
        <div class="modal-backdrop absolute inset-0"></div>
        <div class="bg-slate-900 border border-cyan-700 rounded-3xl w-full max-w-2xl max-h-[80vh] overflow-hidden relative shadow-2xl flex flex-col">
            <div class="p-6 border-b border-cyan-800 flex justify-between items-center bg-cyan-950/20">
                <h2 class="text-2xl font-bold flex items-center gap-2 text-cyan-400"><span>🌵</span> Cryogenic Chamber</h2>
                <button id="close-cryo" class="text-slate-500 hover:text-white text-2xl">&times;</button>
            </div>
            <div class="p-6 overflow-y-auto">
                <div id="cryo-list" class="space-y-4"></div>
            </div>
        </div>
    </div>

    <div id="market-modal" class="fixed inset-0 z-[60] flex items-center justify-center p-4 hidden">
        <div class="modal-backdrop absolute inset-0"></div>
        <div class="bg-slate-900 border border-amber-700/50 rounded-3xl w-full max-w-4xl max-h-[85vh] overflow-hidden relative shadow-2xl flex flex-col">
            <div class="p-6 border-b border-slate-800 flex justify-between items-center bg-amber-950/10">
                <div class="flex gap-4">
                    <button onclick="gameState.switchMarketTab('buy')" id="tab-buy" class="text-2xl font-bold text-white opacity-100">🏪 Market</button>
                    <button onclick="gameState.switchMarketTab('sell')" id="tab-sell" class="text-2xl font-bold text-white opacity-40">🏷️ Sales</button>
                </div>
                <button id="close-market" class="text-slate-500 hover:text-white text-2xl">&times;</button>
            </div>
            <div id="market-buy-view" class="p-6 overflow-y-auto flex-1">
                <div id="market-stock-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
            </div>
            <div id="market-sell-view" class="p-6 overflow-y-auto flex-1 hidden"></div>
        </div>
    </div>

    <div id="toast-container" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-[100] pointer-events-none flex flex-col gap-2 w-full max-w-sm px-4"></div>

