            tick() {
                this.tickCount++;
                const now = Date.now();
                let totalIncome = 0;


                // Process Boost Timers
                let boostsChanged = false;
                ['luck', 'profit'].forEach(b => {
                    if (this.activeBoosts[b].timer > 0) {
                        this.activeBoosts[b].timer--;
                        if (this.activeBoosts[b].timer <= 0) {
                            this.activeBoosts[b].mult = 1; // Reset
                            this.showToast(`${b.toUpperCase()} Boost expired!`, "info");
                        }
                        boostsChanged = true;
                    }
                });


                // Spin Timer Logic
                if (this.spinTimer > 0) {
                    this.spinTimer--;
                    if (this.spinTimer <= 0) {
                        this.freeSpins++;
                        this.spinTimer = 3600;
                        this.showToast("Hourly Reward available!", "special");
                        document.getElementById('wheel-notif').classList.remove('hidden');
                    }
                    const min = Math.floor(this.spinTimer / 60);
                    const sec = this.spinTimer % 60;
                    document.getElementById('wheel-timer').innerText = `${min}:${sec.toString().padStart(2, '0')}`;
                }


                // Billion Egg Cooldown Tick
                if (this.billionEggCooldown > 0) {
                    this.billionEggCooldown--;
                    const bMin = Math.floor(this.billionEggCooldown / 60);
                    const bSec = this.billionEggCooldown % 60;
                    document.getElementById('billion-egg-cooldown-text').innerText = `Cooldown: ${bMin}:${bSec.toString().padStart(2, '0')}`;
                } else {
                    document.getElementById('billion-egg-cooldown-text').innerText = "Ready to Open";
                }


                const profitMult = this.activeBoosts.profit.mult || 1;


                this.animals.forEach(a => {
                    const baseIncome = RARITY_INCOME[a.mutation.rarity] || 1;
                    totalIncome += baseIncome * profitMult;
                    if (!a.level) a.level = 0;
                    if (a.level < 15) {
                        a.exp = (a.exp || 0) + 1;
                        if (a.exp >= (120 + a.level * 30)) {
                            a.level++; a.exp = 0;
                            this.showToast(`${a.name} is now Lv. ${a.level}!`, "success");
                        }
                    }
                    if (a.isInCryo && now >= a.cryoEndTime) this.finishCryo(a);
                });


                this.money += totalIncome;


                Object.keys(this.maintenance).forEach(key => {
                    if (this.maintenance[key].cooldown > 0) {
                        this.maintenance[key].cooldown--;
                        this.updateMaintenanceUI(key);
                    }
                });


                // Fermentation Check
                this.extractedMutations.forEach(m => {
                    if (!m.isFermented && m.extractedAt && (now - m.extractedAt >= 60 * 60 * 1000)) {
                        m.isFermented = true;
                        this.showToast(`${m.name} Orb has fermented!`, "special");
                    }
                });


                // Periodically check if your listings were sold by querying the DB
                if (this.tickCount % 5 === 0 && this.activeListings.length > 0) {
                    this.checkSoldListings();
                }


                // --- REAL TIME UI UPDATES ---
                if (!document.getElementById('detail-modal').classList.contains('hidden') && this.currentlyViewingAnimal) {
                    const a = this.currentlyViewingAnimal;
                    const timeNeeded = 120 + ((a.level || 0) * 30);
                    const progress = (((a.exp || 0) / timeNeeded) * 100).toFixed(1);
                    
                    const pEl = document.getElementById('detail-progress-text');
                    if(pEl) pEl.innerText = `${progress}%`;
                    
                    const lEl = document.getElementById('detail-level-text');
                    if(lEl) lEl.innerText = `${a.level || 0}/15`;
                }


                if (!document.getElementById('cryo-modal').classList.contains('hidden')) {
                    this.animals.forEach(a => {
                        if (a.isInCryo) {
                            const el = document.getElementById(`cryo-timer-${a.id}`);
                            if (el) {
                                const timeLeft = Math.max(0, Math.ceil((a.cryoEndTime - Date.now()) / 1000));
                                el.innerText = `${Math.floor(timeLeft/60)}:${(timeLeft%60).toString().padStart(2,'0')}`;
                            }
                        }
                    });
                }


                document.getElementById('money-display').innerText = `$${Math.floor(this.money).toLocaleString()}`;
                document.getElementById('income-display').innerText = `+$${totalIncome}/s`;
                document.getElementById('pop-display').innerText = `${this.animals.length}/${this.getMaxPop()}`;
                this.saveData();
            },


            getMaxPop() {
                return 24 + ((this.upgrades.pop?.level || 1) - 1) * 3;
            },


            updateUI() {
                const grid = document.getElementById('inventory-grid');
                grid.innerHTML = '';
                this.animals.forEach(a => grid.appendChild(this.createAnimalCard(a)));
                document.getElementById('empty-state').style.display = this.animals.length ? 'none' : 'flex';


                ['luck', 'profit', 'maint', 'pop'].forEach(t => {
                    const upg = this.upgrades[t];
                    document.getElementById(`${t}-level`).innerText = `Lv. ${upg.level}${upg.level >= 100 ? ' (MAX)' : ''}`;
                    document.getElementById(`${t}-cost`).innerText = upg.level >= 100 ? '---' : `$${this.getUpgradeCost(t).toLocaleString()}`;
                });


                // UPDATE LAB UI
                const p1 = this.selectedForLab[0];
                const p2 = this.selectedForLab[1];
                
                [0, 1].forEach(i => {
                    const item = this.selectedForLab[i];
                    const el = document.getElementById(`parent-${i+1}`);
                    el.className = 'w-16 h-16 bg-slate-800 rounded-lg flex flex-col items-center justify-center border shadow-inner relative overflow-hidden cursor-pointer hover:border-indigo-500 transition-colors ' + 
                                   (item && item.type === 'mutation' ? `border-${item.rarity.toLowerCase() === 'normal' ? 'slate-500' : 'indigo-500'} bg-indigo-900/30` : 'border-slate-700');
                    
                    if (item) {
                        if (item.type === 'mutation') {
                            el.querySelector('.emoji').innerHTML = `<span class="orb-glow rarity-${item.rarity.toLowerCase()} drop-shadow-md text-2xl">🔮</span>`;
                            el.querySelector('.mut-tag').innerText = `P. lvl: ${item.purity || 0} ` + item.name;
                        } else {
                            el.querySelector('.emoji').innerText = item.emoji || '?';
                            el.querySelector('.mut-tag').innerText = item.mutation.name || '';
                        }
                    } else {
                        el.querySelector('.emoji').innerText = '?';
                        el.querySelector('.mut-tag').innerText = '';
                    }
                });
                
                // Button logic
                const canExtract = this.selectedForLab.length === 1 && !p1.type && p1.mutation.id !== 'normal';
                document.getElementById('lab-extract-btn').disabled = !canExtract;
                if (this.extractionTokens > 0) {
                    document.getElementById('lab-extract-btn').innerText = `EXTRACT (Uses 1 Token) [${this.extractionTokens} Left]`;
                    document.getElementById('lab-extract-btn').classList.replace('bg-purple-600', 'bg-pink-600');
                    document.getElementById('lab-extract-btn').classList.replace('hover:bg-purple-500', 'hover:bg-pink-500');
                } else {
                    document.getElementById('lab-extract-btn').innerText = `EXTRACT ($1,000,000,000)`;
                    document.getElementById('lab-extract-btn').classList.replace('bg-pink-600', 'bg-purple-600');
                    document.getElementById('lab-extract-btn').classList.replace('hover:bg-pink-500', 'hover:bg-purple-500');
                }


                const canBreed = this.selectedForLab.length === 2 && !p1.type && !p2.type;
                document.getElementById('lab-breed-btn').disabled = !canBreed;


                let canTransfer = false;
                if (this.selectedForLab.length === 2) {
                    if (!p1.type && !p2.type) canTransfer = p1.mutation.id !== 'normal';
                    else if ((!p1.type && p2.type === 'mutation') || (p1.type === 'mutation' && !p2.type)) canTransfer = true;
                    else if (p1.type === 'mutation' && p2.type === 'mutation') {
                        canTransfer = (p1.mutationId === p2.mutationId && (p1.purity || 0) === (p2.purity || 0) && (p1.purity || 0) < 5);
                    }
                }
                document.getElementById('lab-transfer-btn').disabled = !canTransfer;


                // Update market listing count visually
                const activeCount = this.activeListings ? this.activeListings.length : 0;
                document.getElementById('listing-count-badge').innerText = `${activeCount}/3`;


                // Update Potion Bag Badge Count
                const pCount = this.potions ? this.potions.length : 0;
                document.getElementById('potions-badge').innerText = pCount;
                if (pCount >= 100) {
                    document.getElementById('potions-badge').classList.replace('bg-emerald-500', 'bg-red-500');
                } else {
                    document.getElementById('potions-badge').classList.replace('bg-red-500', 'bg-emerald-500');
                }


                // Boosts UI
                const boostsContainer = document.getElementById('active-boosts-container');
                const boostsList = document.getElementById('boosts-list');
                boostsList.innerHTML = '';
                let hasBoosts = false;
                
                ['luck', 'profit'].forEach(b => {
                    if (this.activeBoosts[b].timer > 0) {
                        hasBoosts = true;
                        const min = Math.floor(this.activeBoosts[b].timer / 60);
                        const sec = this.activeBoosts[b].timer % 60;
                        const color = b === 'luck' ? 'indigo' : 'emerald';
                        boostsList.innerHTML += `
                            <div class="flex justify-between items-center bg-slate-900 p-2 rounded-lg border border-${color}-500/30 shadow-inner">
                                <span class="text-xs font-bold text-${color}-400 uppercase">${this.activeBoosts[b].mult}x ${b}</span>
                                <span class="text-xs font-mono text-slate-300">${min}:${sec.toString().padStart(2, '0')}</span>
                            </div>
                        `;
                    }
                });
                boostsContainer.style.display = hasBoosts ? 'block' : 'none';
                
                // Update wheel button
                const spinBtn = document.getElementById('spin-btn');
                if (spinBtn) {
                    spinBtn.innerText = `OPEN REWARD (${this.freeSpins} Available)`;
                    spinBtn.disabled = this.freeSpins <= 0 || this.isSpinning;
                }
            },


            getUpgradeCost(type) {
                const upg = this.upgrades[type];
                let mult = 2.0;
                if (type === 'luck') mult = 2.5;
                if (type === 'pop') mult = 2.5;
                return Math.floor(upg.baseCost * Math.pow(mult, upg.level - 1));
            },


            upgrade(type) {
                if (this.upgrades[type].level >= 100) return;
                const cost = this.getUpgradeCost(type);
                if (this.money >= cost) {
                    this.money -= cost;
                    this.upgrades[type].level++;
                    this.updateUI();
                } else { this.showToast("Not enough money!"); }
            },


            createAnimalCard(animal) {
                const isSelected = this.selectedForLab.find(a => a && !a.type && a.id === animal.id);
                const div = document.createElement('div');
                div.className = `animal-card p-3 rounded-xl cursor-pointer ${isSelected ? 'ring-2 ring-indigo-500 bg-indigo-900/30' : ''} ${animal.isWarborn ? 'warborn-glint' : ''}`;
                const val = this.calcVal(animal);
                const rarityClass = `rarity-${animal.mutation.rarity.toLowerCase()}`;
                
                div.innerHTML = `
                    <div class="flex justify-between items-start">
                        <span class="text-2xl">${animal.emoji}</span>
                        <div class="flex flex-col items-end">
                            <div class="flex items-center gap-1">
                                ${animal.locked ? '<span class="text-[10px]" title="Locked">🔒</span>' : ''}
                                ${animal.isFermented ? '<span class="text-[10px]" title="Fermented">🦠</span>' : ''}
                                <span class="text-[8px] font-bold uppercase ${rarityClass}">P. lvl: ${animal.purity || 0} | ${animal.mutation.rarity}</span>
                            </div>
                            <span class="text-[8px] bg-slate-700 px-1 rounded text-slate-300 mt-1">Lv.${animal.level || 0}</span>
                        </div>
                    </div>
                    <h3 class="font-bold text-white text-[10px] truncate mt-1">${animal.mutation.name} ${animal.name}</h3>
                    <p class="text-emerald-400 font-mono text-[9px]">$${Math.floor(val).toLocaleString()}</p>
                    <div class="flex gap-1 mt-2">
                        <button class="lab-btn flex-1 bg-indigo-500/20 text-indigo-400 text-[8px] font-bold py-1 rounded hover:bg-indigo-500/40">Lab</button>
                        <button class="sell-btn flex-1 ${animal.locked ? 'bg-slate-700/50 text-slate-500 cursor-not-allowed' : 'bg-red-500/20 text-red-400 hover:bg-red-500/30'} text-[8px] font-bold py-1 rounded transition-colors">Sell (NPC)</button>
                    </div>
                `;
                
                div.onclick = () => this.showAnimalDetails(animal);
                
                // Right click to lock
                div.oncontextmenu = (e) => {
                    e.preventDefault();
                    animal.locked = !animal.locked;
                    this.saveData();
                    this.updateUI();
                    this.showToast(animal.locked ? "Animal locked." : "Animal unlocked.", "info");
                };


                div.querySelector('.lab-btn').onclick = (e) => { e.stopPropagation(); this.toggleLabAnimal(animal); };
                
                div.querySelector('.sell-btn').onclick = (e) => { 
                    e.stopPropagation(); 
                    if (animal.locked) {
                        this.showToast("This animal is locked!", "error");
                        return;
                    }
                    this.sellAnimalInstantly(animal.id); 
                };
                
                return div;
            },


            calcVal(a) {
                let v = a.baseValue * a.mutation.valueMult;
                if (a.isWarborn) v *= 1.5;
                if (a.isFermented) v *= 1.25;
                const purityMults = [1, 1.5, 2, 2.5, 3, 4];
                v *= purityMults[a.purity || 0] || 1;
                
                const profitMult = this.activeBoosts.profit.mult || 1;
                return v * (1 + (this.upgrades.profit.level - 1) * 0.12) * profitMult;
            },


            showAnimalDetails(animal) {
                this.currentlyViewingAnimal = animal;
                const content = document.getElementById('detail-content');
                const val = this.calcVal(animal);
                const baseIncome = RARITY_INCOME[animal.mutation.rarity] || 1;
                const timeNeeded = 120 + ((animal.level || 0) * 30);
                const progress = (((animal.exp || 0) / timeNeeded) * 100).toFixed(1);


                content.innerHTML = `
                    <div class="text-6xl mb-4 floating">${animal.emoji}</div>
                    <h2 class="text-2xl font-bold text-white">${animal.mutation.name} ${animal.name}</h2>
                    <p class="rarity-${animal.mutation.rarity.toLowerCase()} font-bold uppercase text-sm mb-4">${animal.isFermented ? '🦠 Fermented | ' : ''}P. lvl: ${animal.purity || 0} | ${animal.mutation.rarity}</p>
                    <div class="grid grid-cols-2 gap-4 w-full bg-slate-800/50 p-4 rounded-2xl mb-4 text-left">
                        <div><p class="text-[10px] text-slate-500 font-bold">Income</p><p class="text-lg text-emerald-400">+$${(baseIncome * (this.activeBoosts.profit.mult || 1)).toLocaleString()}/s</p></div>
                        <div><p class="text-[10px] text-slate-500 font-bold">Value</p><p class="text-lg text-emerald-400">$${Math.floor(val).toLocaleString()}</p></div>
                        <div><p class="text-[10px] text-slate-500 font-bold">Level</p><p class="text-lg text-white" id="detail-level-text">${animal.level || 0}/15</p></div>
                        <div><p class="text-[10px] text-slate-500 font-bold">Next</p><p class="text-lg text-indigo-400" id="detail-progress-text">${progress}%</p></div>
                        <div class="col-span-2"><p class="text-[10px] text-slate-500 font-bold">Acquired</p><p class="text-xs text-slate-400">${new Date(animal.acquiredAt || Date.now()).toLocaleString()}</p></div>
                    </div>
                    <button onclick="gameState.listOnMarket('${animal.id}', 'animal')" class="w-full py-4 bg-amber-600 hover:bg-amber-500 rounded-xl font-bold text-xs shadow-lg transition-all">LIST ON GLOBAL MARKET</button>
                `;
                this.openModal('detail-modal');
            },


            // --- LAB & EXTRACT LOGIC ---
            toggleLabAnimal(animal) {
                const idx = this.selectedForLab.findIndex(a => a && !a.type && a.id === animal.id);
                if (idx > -1) this.selectedForLab.splice(idx, 1);
                else if (this.selectedForLab.length < 2) this.selectedForLab.push(animal);
                this.updateUI();
            },


            handleSlotClick(index) {
                if (this.selectedForLab[index]) {
                    // Remove from lab
                    this.selectedForLab.splice(index, 1);
                    this.updateUI();
                } else {
                    // Empty slot clicked -> Open Mutation Inventory
                    this.openLabInventory();
                }
            },


            doExtract() {
                if (this.selectedForLab.length !== 1 || this.selectedForLab[0].type === 'mutation') return;
                const animal = this.selectedForLab[0];
                if (animal.mutation.id === 'normal') return;
                
                let cost = 1000000000;
                let usedToken = false;
                if (this.extractionTokens > 0) {
                    usedToken = true;
                    cost = 0;
                }
                
                if (!usedToken && this.money < cost) {
                    this.showToast("Need $1,000,000,000 to extract!", "error");
                    return;
                }
                
                if (usedToken) {
                    this.extractionTokens--;
                } else {
                    this.money -= cost;
                }


                const mutToExtract = { 
                    type: 'mutation',
                    id: crypto.randomUUID(),
                    mutationId: animal.mutation.id,
                    name: animal.mutation.name,
                    rarity: animal.mutation.rarity,
                    valueMult: animal.mutation.valueMult,
                    extractedAt: Date.now(),
                    isFermented: animal.isFermented || false,
                    purity: animal.purity || 0
                };
                
                this.extractedMutations.push(mutToExtract);
                
                // Make animal normal
                const normalMut = MUTATIONS.find(m => m.id === 'normal');
                animal.mutation = { ...normalMut };
                animal.isFermented = false;
                animal.purity = 0;
                
                this.selectedForLab = [];
                this.showToast(`${mutToExtract.name} mutation extracted!`, "success");
                this.updateUI();
            },


            openLabInventory() {
                const list = document.getElementById('lab-inventory-list');
                list.innerHTML = '';


                if (this.extractedMutations.length === 0) {
                    list.innerHTML = `<div class="col-span-full text-slate-500 italic p-10 text-center">No extracted mutations found.<br>Use the Extract button in the Gene Lab.</div>`;
                }


                this.extractedMutations.forEach(mut => {
                    const rarityClass = `rarity-${mut.rarity.toLowerCase()}`;
                    const isSelected = this.selectedForLab.find(m => m && m.type === 'mutation' && m.id === mut.id);


                    list.innerHTML += `
                        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 flex flex-col justify-between ${isSelected ? 'ring-2 ring-indigo-500' : ''}">
                            <div class="flex items-center gap-3 mb-4">
                                <span class="text-4xl orb-glow drop-shadow-lg ${rarityClass}">🔮</span>
                                <div>
                                    <p class="font-bold text-white text-sm">${mut.name} Orb</p>
                                    <div class="flex gap-1 items-center">
                                        ${mut.isFermented ? '<span class="text-[10px]" title="Fermented">🦠</span>' : ''}
                                        <p class="text-[10px] font-bold uppercase ${rarityClass}">P. lvl: ${mut.purity || 0} | ${mut.rarity}</p>
                                    </div>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="gameState.toggleMutationLab('${mut.id}')" class="flex-1 py-2 bg-indigo-600/30 text-indigo-300 hover:bg-indigo-600/50 rounded-lg text-[10px] font-bold transition-colors">
                                    ${isSelected ? 'Remove' : 'Use in Lab'}
                                </button>
                                <button onclick="gameState.listOnMarket('${mut.id}', 'mutation')" class="flex-1 py-2 bg-amber-600/30 text-amber-300 hover:bg-amber-600/50 rounded-lg text-[10px] font-bold transition-colors border border-amber-500/20">Sell</button>
                            </div>
                        </div>
                    `;
                });


                this.openModal('lab-inventory-modal');
            },


            toggleMutationLab(id) {
                const idx = this.selectedForLab.findIndex(m => m && m.type === 'mutation' && m.id === id);
                if (idx > -1) {
                    this.selectedForLab.splice(idx, 1);
                } else if (this.selectedForLab.length < 2) {
                    const mut = this.extractedMutations.find(m => m.id === id);
                    this.selectedForLab.push(mut);
                }
                this.updateUI();
                this.openLabInventory(); // Refresh view for selection highlight
            },


            doBreed() {
                if (this.selectedForLab.length !== 2 || this.selectedForLab[0].type || this.selectedForLab[1].type) return;
                if (this.money < 500) { this.showToast("Need $500!"); return; }
                const luckBonus = 2 + (RARITY_LEVELS[this.selectedForLab[0].mutation.rarity] * 5) + (RARITY_LEVELS[this.selectedForLab[1].mutation.rarity] * 5);
                this.money -= 500;
                this.selectedForLab = [];
                this.hatchEgg(luckBonus);
            },


            doTransfer() {
                if (this.selectedForLab.length !== 2) return;
                
                const item1 = this.selectedForLab[0];
                const item2 = this.selectedForLab[1];
                
                // Identify the elements in play
                let animalTarget, sourceObj;
                
                if (item1.type !== 'mutation' && item2.type !== 'mutation') {
                    // Two animals: slot 1 is sacrificed, slot 2 receives it
                    sourceObj = item1;
                    animalTarget = item2;
                    
                    if (sourceObj.mutation.id === 'normal') return;
                    if (this.money < 2500) { this.showToast("Need $2,500!"); return; }
                    this.money -= 2500;
                    
                    const targetIdx = this.animals.findIndex(a => a.id === animalTarget.id);
                    this.animals[targetIdx].mutation = { ...sourceObj.mutation };
                    this.animals[targetIdx].isFermented = sourceObj.isFermented || false;
                    this.animals[targetIdx].purity = sourceObj.purity || 0;
                    
                    // Sacrifice source
                    this.animals.splice(this.animals.findIndex(a => a.id === sourceObj.id), 1);
                    
                    this.selectedForLab = [];
                    this.showToast("Gene Transfer Successful!", "success");
                    this.updateUI();


                } else if (item1.type === 'mutation' && item2.type === 'mutation') {
                    // Combining Orbs
                    if (item1.mutationId !== item2.mutationId || (item1.purity || 0) !== (item2.purity || 0)) return;
                    if ((item1.purity || 0) >= 5) return;
                    if (this.money < 2500) { this.showToast("Need $2,500!"); return; }
                    this.money -= 2500;


                    const newPurity = (item1.purity || 0) + 1;
                    const newFermented = item1.isFermented || item2.isFermented;


                    const newOrb = {
                        type: 'mutation',
                        id: crypto.randomUUID(),
                        mutationId: item1.mutationId,
                        name: item1.name,
                        rarity: item1.rarity,
                        valueMult: item1.valueMult,
                        extractedAt: Date.now(), // Reset fermentation timer
                        isFermented: newFermented,
                        purity: newPurity
                    };


                    this.extractedMutations = this.extractedMutations.filter(m => m.id !== item1.id && m.id !== item2.id);
                    this.extractedMutations.push(newOrb);


                    this.selectedForLab = [];
                    this.showToast(`Combined into P. lvl ${newPurity} Orb!`, "success");
                    this.updateUI();


                } else {
                    // One orb, one animal. Order doesn't matter here.
                    const orb = item1.type === 'mutation' ? item1 : item2;
                    const pet = item1.type !== 'mutation' ? item1 : item2;


                    if (this.money < 2500) { this.showToast("Need $2,500!"); return; }
                    this.money -= 2500;
                    
                    const baseMut = MUTATIONS.find(m => m.id === orb.mutationId);
                    const targetIdx = this.animals.findIndex(a => a.id === pet.id);
                    this.animals[targetIdx].mutation = { ...baseMut };
                    this.animals[targetIdx].isFermented = orb.isFermented || false;
                    this.animals[targetIdx].purity = orb.purity || 0;
                    
                    // remove mutation orb from inventory
                    this.extractedMutations = this.extractedMutations.filter(m => m.id !== orb.id);
                    
                    this.selectedForLab = [];
                    this.showToast(`Applied ${baseMut.name} to ${pet.name}!`, "success");
                    this.updateUI();
                }
            },


            // --- POTIONS BAG LOGIC ---
            openPotions() {
                const list = document.getElementById('potions-list');
                list.innerHTML = '';
                
                if (this.potions.length === 0) {
                    list.innerHTML = `<div class="col-span-full text-slate-500 italic p-10 text-center">Your potion bag is currently empty.</div>`;
                }


                this.potions.forEach(p => {
                    const typeColor = p.type === 'luck' ? 'border-indigo-500/50 bg-indigo-950/20' : 'border-emerald-500/50 bg-emerald-950/20';
                    const labelColor = p.type === 'luck' ? 'text-indigo-400' : 'text-emerald-400';
                    const sellVal = p.mult === 2 ? 150000 : 50000;
                    
                    list.innerHTML += `
                        <div class="p-4 rounded-xl border ${typeColor} flex flex-col justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <span class="text-3xl">🧪</span>
                                <div>
                                    <p class="font-bold text-white text-sm">${p.name}</p>
                                    <p class="text-[10px] font-mono text-slate-400">${Math.floor(p.duration / 60)} Minutes Duration</p>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="gameState.usePotion('${p.id}')" class="flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-lg transition-colors">USE BOOST</button>
                                <button onclick="gameState.listOnMarket('${p.id}', 'potion')" class="flex-1 py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs rounded-lg transition-colors border border-amber-500/50 shadow-lg">MARKET</button>
                                <button onclick="gameState.sellPotion('${p.id}', ${sellVal})" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-emerald-400 font-mono text-xs rounded-lg transition-colors border border-slate-700">SELL ($${sellVal.toLocaleString()})</button>
                            </div>
                        </div>
                    `;
                });
                
                document.getElementById('potions-count-text').innerText = `${this.potions.length} / 100`;
                this.openModal('potions-modal');
            },


            addPotion(name, type, mult, duration) {
                if (this.potions.length >= 100) {
                    this.showToast("Your Potion Bag is full (100 Max)!", "error");
                    return false;
                }
                const newPot = {
                    id: crypto.randomUUID(),
                    name: name,
                    type: type, // 'luck' or 'profit'
                    mult: mult,
                    duration: duration // In seconds
                };
                this.potions.push(newPot);
                this.updateUI();
                return true;
            },


            usePotion(id) {
                const pIdx = this.potions.findIndex(p => p.id === id);
                if (pIdx === -1) return;
                
                const p = this.potions.splice(pIdx, 1)[0];
                
                // Set/Extend active boost
                this.activeBoosts[p.type] = {
                    mult: p.mult,
                    timer: (this.activeBoosts[p.type].timer || 0) + p.duration
                };
                
                this.showToast(`${p.name} Activated!`, "success");
                this.saveData();
                this.updateUI();
                this.openPotions(); // Refresh modal
            },


            sellPotion(id, amount) {
                const pIdx = this.potions.findIndex(p => p.id === id);
                if (pIdx === -1) return;
                
