                                    </div>
                                    <span class="text-[10px] bg-slate-700 px-2 py-1 rounded text-slate-300 mt-1">${isPotion ? Math.floor(obj.duration/60) + ' Mins' : (isMutation ? 'Extracted Orb' : 'Lv.' + (obj.level || 0))}</span>
                                </div>
                            </div>
                            <p class="font-bold text-white text-xs truncate">${isPotion ? obj.name : (isMutation ? obj.name + ' Orb' : obj.mutation.name + ' ' + obj.name)}</p>
