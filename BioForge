            formatCurrencyDisplay(amount, currency) {
                if (!currency || currency === 'dollars') return `$${amount.toLocaleString()}`;
                if (currency === 'extraction_tokens') return `🎫 ${amount} Ext. Token(s)`;
                if (currency === 'reward_tokens') return `🎁 ${amount} Reward Token(s)`;
                if (currency === 'loot_egg_tickets') return `🎟️ ${amount} Loot Ticket(s)`;
                return `${amount} ${currency}`;
            },


            async buyFromMarket(listingId, price, currency = 'dollars') {
                if (currency === 'dollars' && this.money < price) { this.showToast("Not enough money!", "error"); return; }
                if (currency === 'extraction_tokens' && this.extractionTokens < price) { this.showToast("Not enough Extraction Tokens!", "error"); return; }
                if (currency === 'reward_tokens' && this.freeSpins < price) { this.showToast("Not enough Reward Tokens!", "error"); return; }
                if (currency === 'loot_egg_tickets' && this.lootEggTickets < price) { this.showToast("Not enough Loot Egg Tickets!", "error"); return; }


                const { data, error } = await supabase
                    .from('market_listings')
                    .delete()
                    .eq('id', listingId)
                    .select();


                if (error || !data || data.length === 0) {
                    this.showToast("This listing was already sold or removed!", "error");
                    this.loadMarketBuy(); 
                    return;
                }


                // Give player the item
                if (currency === 'dollars') this.money -= price;
                else if (currency === 'extraction_tokens') this.extractionTokens -= price;
                else if (currency === 'reward_tokens') this.freeSpins -= price;
                else if (currency === 'loot_egg_tickets') this.lootEggTickets -= price;
                
                const purchasedItem = data[0].animal_data;
                purchasedItem.id = crypto.randomUUID(); 
                const category = purchasedItem.marketCategory || (purchasedItem.type === 'mutation' ? 'mutation' : 'animal');
                
                if (category === 'mutation') {
                    this.extractedMutations.push(purchasedItem);
                    this.showToast(`Purchased ${purchasedItem.name} Orb from ${data[0].seller_name}!`, "success");
                } else if (category === 'potion') {
                    if (this.potions.length >= 100) {
                        this.showToast("Potion Bag full! Restoring purchase...", "error");
                        this.money += price;
                        supabase.from('market_listings').insert([data[0]]).then();
                        return;
                    }
                    this.potions.push(purchasedItem);
                    this.showToast(`Purchased ${purchasedItem.name} from ${data[0].seller_name}!`, "success");
                } else {
                    // Make sure habitats aren't full if buying an animal
                    if (this.animals.length + this.pendingHatches >= this.getMaxPop()) {
                        this.showToast("Habitats full! Restoring purchase...", "error");
                        this.money += price;
                        // Re-list it immediately since they couldn't fit it (hacky but safe for no-backend loss)
                        supabase.from('market_listings').insert([data[0]]).then();
                        return;
                    }
                    this.animals.push(purchasedItem);
                    this.showToast(`Purchased ${purchasedItem.mutation.name} ${purchasedItem.name} from ${data[0].seller_name}!`, "success");
                }
                
                this.loadMarketBuy();
                this.updateUI();
            },


            listOnMarket(id, category = 'animal') {
                // Backwards compat for old boolean calls if any were missed
                if (category === true) category = 'mutation';
                if (category === false) category = 'animal';


                if (this.activeListings && this.activeListings.length >= 3) {
                    this.showToast("You can only have 3 active listings!", "error");
                    return;
                }
                
                let item;
                if (category === 'mutation') item = this.extractedMutations.find(m => m.id == id);
                else if (category === 'potion') item = this.potions.find(p => p.id == id);
                else item = this.animals.find(a => a.id == id);
                
                if (!item) return;


                item.marketCategory = category;


                this.itemToEdit = item;
                this.closeModal('detail-modal');
                this.closeModal('lab-inventory-modal');
                this.closeModal('potions-modal');
                
                // Populate modal defaults
                document.getElementById('seller-name-input').value = this.playerName || '';
                
                // Suggest a price
                let suggestedPrice = 1000;
                if (category === 'mutation') {
                    const purityMults = [1, 1.5, 2, 2.5, 3, 4];
                    const pMult = purityMults[item.purity || 0] || 1;
                    const fermMult = item.isFermented ? 1.25 : 1;
                    suggestedPrice = Math.floor(item.valueMult * 1000 * pMult * fermMult);
                } else if (category === 'potion') {
                    suggestedPrice = item.mult >= 2 ? 250000 : 75000; // Above standard NPC sell rate
                } else {
                    suggestedPrice = Math.floor(this.calcVal(item));
                }
                
                document.getElementById('list-price-input').value = suggestedPrice;
                document.getElementById('list-currency-input').value = 'dollars';
                
                this.openModal('list-modal');
            },


            async confirmList() {
                const nameInput = document.getElementById('seller-name-input').value.trim();
                const priceInput = parseInt(document.getElementById('list-price-input').value);
                const currencyInput = document.getElementById('list-currency-input').value;


                if (!nameInput) { this.showToast("Please enter your display name.", "error"); return; }
                if (isNaN(priceInput) || priceInput <= 0) { this.showToast("Enter a valid price.", "error"); return; }


                this.playerName = nameInput;
                const item = this.itemToEdit;
                const category = item.marketCategory;
                
                // Save currency inside item payload to avoid needing a backend table change
                item.marketCurrency = currencyInput;
                
                // Remove from local inventory
                if (category === 'mutation') {
                    const idx = this.extractedMutations.findIndex(m => m.id == item.id);
                    this.extractedMutations.splice(idx, 1);
                } else if (category === 'potion') {
                    const idx = this.potions.findIndex(p => p.id == item.id);
                    this.potions.splice(idx, 1);
                } else {
                    const idx = this.animals.findIndex(a => a.id == item.id);
                    this.animals.splice(idx, 1);
                }
                
                this.closeModal('list-modal');
                
                const listing = {
                    seller_name: this.playerName,
                    seller_id: this.playerId,
                    animal_data: item,
                    price: priceInput
                };


                const { data, error } = await supabase
                    .from('market_listings')
                    .insert([listing])
                    .select();


                if (error) {
                    console.error("Insert Error:", error);
                    this.showToast("Failed to connect to global market.", "error");
                    if (category === 'mutation') this.extractedMutations.push(item);
                    else if (category === 'potion') this.potions.push(item);
                    else this.animals.push(item);
                    this.updateUI();
                    return;
                }


                if (!this.activeListings) this.activeListings = [];
                this.activeListings.push({ id: data[0].id, animal: item, price: priceInput });


                this.showToast("Item is now live on the market!", "success");
                this.updateUI();
            },


