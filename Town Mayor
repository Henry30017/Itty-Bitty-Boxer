import React, { useState, useEffect, useRef } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, doc, setDoc, getDoc } from 'firebase/firestore';

// --- GAME DATA ---
const HOUSING = [
  { id: 'tent', name: 'Tent Camp', icon: '⛺', cost: 250, pop: 2 },
  { id: 'cabin', name: 'Log Cabin', icon: '🛖', cost: 1000, pop: 8 },
  { id: 'house', name: 'Suburban House', icon: '🏠', cost: 4500, pop: 25 },
  { id: 'apartment', name: 'Apartment Block', icon: '🏢', cost: 20000, pop: 100 },
  { id: 'highrise', name: 'High-Rise Condo', icon: '🏙️', cost: 85000, pop: 400 }
];

const BUILDINGS = [
  { id: 'farm', name: 'Wheat Farm', export: 'Wheat', icon: '🌾', cost: 500, maxWorkers: 5, basePrice: 5, wage: 1000 },
  { id: 'bakery', name: 'Industrial Bakery', export: 'Bread', icon: '🍞', cost: 1200, maxWorkers: 8, basePrice: 12, wage: 2500 },
  { id: 'lumber', name: 'Lumber Mill', export: 'Wood', icon: '🌲', cost: 3000, maxWorkers: 10, basePrice: 30, wage: 6500 },
  { id: 'mine', name: 'Iron Mine', export: 'Ore', icon: '⛏️', cost: 7500, maxWorkers: 15, basePrice: 80, wage: 18000 },
  { id: 'textile', name: 'Textile Factory', export: 'Clothes', icon: '🧶', cost: 15000, maxWorkers: 20, basePrice: 160, wage: 38000 },
  { id: 'pottery', name: 'Pottery Studio', export: 'Pots', icon: '🏺', cost: 30000, maxWorkers: 10, basePrice: 350, wage: 85000 },
  { id: 'blacksmith', name: 'Blacksmith', export: 'Tools', icon: '⚒️', cost: 65000, maxWorkers: 12, basePrice: 800, wage: 200000 },
  { id: 'furniture', name: 'Furniture Plant', export: 'Chairs', icon: '🪑', cost: 150000, maxWorkers: 15, basePrice: 2000, wage: 500000 },
  { id: 'glassworks', name: 'Glassworks', export: 'Glass', icon: '🪟', cost: 350000, maxWorkers: 20, basePrice: 4500, wage: 1150000 },
  { id: 'toy', name: 'Toy Factory', export: 'Toys', icon: '🧸', cost: 800000, maxWorkers: 25, basePrice: 10000, wage: 2600000 },
  { id: 'electronics', name: 'Electronics Plant', export: 'Gadgets', icon: '💻', cost: 2000000, maxWorkers: 30, basePrice: 25000, wage: 6800000 },
  { id: 'auto', name: 'Automobile Factory', export: 'Cars', icon: '🚗', cost: 5000000, maxWorkers: 50, basePrice: 70000, wage: 19000000 }
];

const PAYDAY_INTERVAL = 300; // 5 minutes
const MARKET_INTERVAL = 60;  // Market changes every 60 seconds

const getInitialState = () => ({
  money: 2000,
  timeAlive: 0,
  paydayTimer: PAYDAY_INTERVAL,
  marketTimer: MARKET_INTERVAL,
  buildings: BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 0 }), {}),
  housing: HOUSING.reduce((acc, h) => ({ ...acc, [h.id]: 0 }), {}),
  workers: BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 0 }), {}),
  inventory: BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 0 }), {}),
  priceMultipliers: BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 1.0 }), {}),
  timeSinceSold: BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 0 }), {}),
  salesThisPayday: BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 0 }), {}),
  priceTrends: BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 'stable' }), {}),
  gameOver: false,
  started: false,
});

export default function App() {
  const [state, setState] = useState(getInitialState());
  const [gameSpeed, setGameSpeed] = useState(1);
  
  // Firebase Auth & Firestore State
  const [user, setUser] = useState(null);
  const [db, setDb] = useState(null);
  const [appId, setAppId] = useState('default-app-id');
  const [isSaving, setIsSaving] = useState(false);
  
  const stateRef = useRef(state);
  useEffect(() => { stateRef.current = state; }, [state]);

  // --- 1. FIREBASE INITIALIZATION & AUTH ---
  useEffect(() => {
    try {
      if (typeof __firebase_config !== 'undefined') {
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const firestoreDb = getFirestore(app);
        setDb(firestoreDb);

        if (typeof __app_id !== 'undefined') setAppId(__app_id);

        const initAuth = async () => {
          if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
            await signInWithCustomToken(auth, __initial_auth_token);
          } else {
            await signInAnonymously(auth);
          }
        };
        initAuth();

        const unsubscribe = onAuthStateChanged(auth, setUser);
        return () => unsubscribe();
      }
    } catch (e) {
      console.error("Firebase init failed:", e);
    }
  }, []);

  // --- 2. LOAD PROGRESS ---
  useEffect(() => {
    if (!user || !db) return;
    const loadData = async () => {
      try {
        const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'saveData', 'gameState');
        const snap = await getDoc(docRef);
        if (snap.exists() && snap.data().started && !snap.data().gameOver) {
          // Merge loaded data with default state to handle any new buildings/features added later
          setState(prev => ({ ...getInitialState(), ...snap.data() }));
        }
      } catch (e) {
        console.error("Failed to load save data:", e);
      }
    };
    loadData();
  }, [user, db, appId]);

  // --- 3. AUTO-SAVE PROGRESS (Every 10 seconds) ---
  useEffect(() => {
    if (!user || !db) return;
    const saveInterval = setInterval(async () => {
      const currentState = stateRef.current;
      if (currentState.started && !currentState.gameOver) {
        setIsSaving(true);
        try {
          const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'saveData', 'gameState');
          await setDoc(docRef, currentState);
        } catch (e) {
          console.error("Autosave failed:", e);
        } finally {
          setTimeout(() => setIsSaving(false), 1000);
        }
      }
    }, 10000);
    return () => clearInterval(saveInterval);
  }, [user, db, appId]);

  // --- 4. CORE GAME LOOP ---
  useEffect(() => {
    if (state.gameOver || !state.started) return;

    const timer = setInterval(() => {
      setState(prev => {
        if (prev.gameOver) return prev;

        let newMoney = prev.money;
        let newPaydayTimer = prev.paydayTimer - 1;
        let newMarketTimer = prev.marketTimer - 1;
        let newTimeAlive = prev.timeAlive + 1;
        let isGameOver = false;

        let newInventory = { ...prev.inventory };
        let newTimeSinceSold = { ...prev.timeSinceSold };
        let newSalesThisPayday = { ...prev.salesThisPayday };
        let newPriceMultipliers = { ...prev.priceMultipliers };
        let newPriceTrends = { ...prev.priceTrends };

        // 1. Generate Products (1 unit per worker per tick)
        BUILDINGS.forEach(b => {
          if (prev.workers[b.id] > 0) {
            newInventory[b.id] += prev.workers[b.id];
          }
          newTimeSinceSold[b.id] += 1; // Increase demand for every tick it isn't sold
        });

        // 2. Process Market Tick
        if (newMarketTimer <= 0) {
          newMarketTimer = MARKET_INTERVAL;
          
          BUILDINGS.forEach(b => {
            const timeHeld = newTimeSinceSold[b.id];
            
            // Base 40%, +5% chance to rise per minute held.
            let chanceToRise = 0.40 + ((timeHeld / 60) * 0.05);

            // If sold at least once this payday, higher chance to drop
            if (newSalesThisPayday[b.id] > 0) {
              chanceToRise -= 0.25; 
            }
            
            // Cap chance to rise between 10% and 90%
            chanceToRise = Math.max(0.10, Math.min(0.90, chanceToRise));

            const isRising = Math.random() < chanceToRise;

            // Price changes between 1% and 8%
            const changePercent = (Math.random() * 0.07) + 0.01; 
            let oldMult = newPriceMultipliers[b.id];
            let newMult = isRising ? oldMult + changePercent : oldMult - changePercent;

            // Hard limits: Price can never go below 50% or above 150%
            newMult = Math.max(0.5, Math.min(1.5, newMult));
            
            newPriceMultipliers[b.id] = newMult;
            newPriceTrends[b.id] = newMult > oldMult ? 'up' : 'down';
          });
        }

        // 3. Process 5-minute Payday
        if (newPaydayTimer <= 0) {
          let totalWages = 0;
          BUILDINGS.forEach(b => {
            totalWages += prev.workers[b.id] * b.wage;
          });
          newMoney -= totalWages;
          newPaydayTimer = PAYDAY_INTERVAL;
          
          // Reset sales tracker for the new payday cycle
          newSalesThisPayday = BUILDINGS.reduce((acc, b) => ({ ...acc, [b.id]: 0 }), {});

          // Check for Bankruptcy
          if (newMoney < 0) {
            isGameOver = true;
          }
        }

        return {
          ...prev,
          money: newMoney,
          paydayTimer: newPaydayTimer,
          marketTimer: newMarketTimer,
          timeAlive: newTimeAlive,
          inventory: newInventory,
          timeSinceSold: newTimeSinceSold,
          salesThisPayday: newSalesThisPayday,
          priceMultipliers: newPriceMultipliers,
          priceTrends: newPriceTrends,
          gameOver: isGameOver
        };
      });
    }, 1000 / gameSpeed);

    return () => clearInterval(timer);
  }, [state.gameOver, state.started, gameSpeed]);

  // --- ACTIONS ---
  const buyBuilding = (id, cost) => {
    if (state.money >= cost) {
      setState(prev => ({
        ...prev,
        money: prev.money - cost,
        buildings: { ...prev.buildings, [id]: prev.buildings[id] + 1 }
      }));
    }
  };

  const buyHousing = (id, cost) => {
    if (state.money >= cost) {
      setState(prev => ({
        ...prev,
        money: prev.money - cost,
        housing: { ...prev.housing, [id]: prev.housing[id] + 1 }
      }));
    }
  };

  const hireWorker = (id) => {
    const totalPop = HOUSING.reduce((sum, h) => sum + (state.housing[h.id] * h.pop), 0);
    const employedPop = BUILDINGS.reduce((sum, b) => sum + state.workers[b.id], 0);
    
    if (employedPop >= totalPop) return; // Cannot hire beyond population

    const b = BUILDINGS.find(x => x.id === id);
    const maxAllowed = state.buildings[id] * b.maxWorkers;
    
    if (state.workers[id] < maxAllowed) {
      setState(prev => ({
        ...prev,
        workers: { ...prev.workers, [id]: prev.workers[id] + 1 }
      }));
    }
  };

  const fireWorker = (id) => {
    if (state.workers[id] > 0) {
      const b = BUILDINGS.find(x => x.id === id);
      const severance = Math.floor(b.wage * 0.5); 
      
      setState(prev => {
        const newMoney = prev.money - severance;
        return {
          ...prev,
          money: newMoney,
          workers: { ...prev.workers, [id]: prev.workers[id] - 1 },
          gameOver: newMoney < 0 
        };
      });
    }
  };

  const sellInventory = (id, percent) => {
    setState(prev => {
      const amountToSell = Math.floor(prev.inventory[id] * (percent / 100));
      if (amountToSell <= 0) return prev;

      const b = BUILDINGS.find(x => x.id === id);
      const currentPrice = b.basePrice * prev.priceMultipliers[id];
      const revenue = amountToSell * currentPrice;

      return {
        ...prev,
        money: prev.money + revenue,
        inventory: { ...prev.inventory, [id]: prev.inventory[id] - amountToSell },
        timeSinceSold: { ...prev.timeSinceSold, [id]: 0 }, // Reset supply/demand timer
        salesThisPayday: { ...prev.salesThisPayday, [id]: prev.salesThisPayday[id] + 1 }
      };
    });
  };

  const hardReset = async () => {
    setState(getInitialState());
    if (user && db) {
       const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'saveData', 'gameState');
       await setDoc(docRef, getInitialState());
    }
  };

  // --- HELPERS ---
  const formatMoney = (val) => {
    return '$' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  const formatTime = (totalSeconds) => {
    const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
    const s = (totalSeconds % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  };

  // --- DERIVED STATS ---
  const upcomingWages = BUILDINGS.reduce((sum, b) => sum + (state.workers[b.id] * b.wage), 0);
  const employedPop = BUILDINGS.reduce((sum, b) => sum + state.workers[b.id], 0);
  const totalPop = HOUSING.reduce((sum, h) => sum + (state.housing[h.id] * h.pop), 0);

  // --- INTRO SCREEN ---
  if (!state.started) {
    return (
      <div className="min-h-screen bg-slate-900 flex items-center justify-center text-slate-200 p-4 font-sans">
        <div className="max-w-md w-full bg-slate-800 p-8 rounded-2xl shadow-2xl border border-slate-700 text-center relative overflow-hidden">
          <h1 className="text-4xl font-black text-emerald-400 mb-4">Capitalist Survival</h1>
          <p className="text-slate-400 mb-6 text-sm">
            Build housing to attract population. Construct factories and hire workers to mass-produce goods. Play the market to sell your inventory at peak prices.
            <br/><br/>
            <strong className="text-rose-400">WARNING:</strong> Workers demand wages every 5 minutes. If you drop below $0 on payday, you're bankrupt!
          </p>
          <button 
            onClick={() => setState(s => ({...s, started: true}))}
            className="w-full py-4 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold text-lg transition-colors shadow-lg shadow-emerald-900/50"
          >
            {state.timeAlive > 0 ? "Resume Saved Game" : "Start Corporation ($2,000)"}
          </button>
          
          {state.timeAlive > 0 && (
             <button onClick={hardReset} className="mt-4 text-xs text-rose-500 hover:text-rose-400 underline">Delete Save & Restart</button>
          )}
        </div>
      </div>
    );
  }

  // --- MAIN UI ---
  return (
    <div className="min-h-screen bg-slate-950 text-slate-300 font-sans flex flex-col">
      {/* Top HUD */}
      <header className="sticky top-0 z-20 bg-slate-900 border-b border-slate-800 shadow-lg p-4">
        <div className="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
          
          <div className="flex flex-col items-center md:items-start">
            <div className="flex items-center gap-2">
              <span className="text-xs font-bold text-slate-500 uppercase tracking-wider">Company Funds</span>
              {isSaving && <span className="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full animate-pulse">Saving...</span>}
            </div>
            <span className={`text-3xl font-black ${state.money < upcomingWages && state.paydayTimer < 60 ? 'text-orange-400 animate-pulse' : 'text-emerald-400'}`}>
              {formatMoney(state.money)}
            </span>
          </div>

          <div className="flex gap-6 bg-slate-950 p-3 rounded-xl border border-slate-800">
            <div className="flex flex-col items-center">
              <span className="text-[10px] uppercase text-slate-500 font-bold tracking-widest">Population</span>
              <span className={`font-mono font-bold ${employedPop >= totalPop && totalPop > 0 ? 'text-amber-400' : 'text-slate-200'}`}>
                {employedPop} / {totalPop}
              </span>
            </div>
            <div className="w-px bg-slate-800"></div>
            <div className="flex flex-col items-center">
              <span className="text-[10px] uppercase text-slate-500 font-bold tracking-widest">Est. Wages</span>
              <span className="text-rose-400 font-mono font-bold">-{formatMoney(upcomingWages)}</span>
            </div>
          </div>

          <div className="flex flex-col items-center md:items-end">
            <span className="text-xs font-bold text-slate-500 uppercase tracking-wider">Time to Payday</span>
            <div className="flex items-center gap-3">
              <span className={`text-3xl font-mono font-black ${state.paydayTimer <= 60 ? 'text-rose-500' : 'text-amber-400'}`}>
                {formatTime(state.paydayTimer)}
              </span>
              <div className="flex bg-slate-800 rounded-lg overflow-hidden ml-2 border border-slate-700">
                <button onClick={() => setGameSpeed(1)} className={`px-2 py-1 text-xs font-bold ${gameSpeed === 1 ? 'bg-amber-500 text-slate-900' : 'text-slate-400 hover:bg-slate-700'}`}>1x</button>
                <button onClick={() => setGameSpeed(2)} className={`px-2 py-1 text-xs font-bold ${gameSpeed === 2 ? 'bg-amber-500 text-slate-900' : 'text-slate-400 hover:bg-slate-700'}`}>2x</button>
                <button onClick={() => setGameSpeed(5)} className={`px-2 py-1 text-xs font-bold ${gameSpeed === 5 ? 'bg-amber-500 text-slate-900' : 'text-slate-400 hover:bg-slate-700'}`}>5x</button>
              </div>
            </div>
          </div>

        </div>
      </header>

      {/* Main Content Grid */}
      <main className="flex-1 max-w-[100rem] w-full mx-auto p-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 overflow-y-auto">
        
        {/* COLUMN 1: Housing */}
        <section>
          <div className="flex justify-between items-end mb-3 border-b border-slate-800 pb-2">
            <h2 className="text-lg font-bold text-white flex items-center gap-2">
              <span>🏡</span> Housing
            </h2>
          </div>
          <div className="grid grid-cols-1 gap-2">
            {HOUSING.map(h => (
              <div key={h.id} className="bg-slate-800 rounded-xl p-3 border border-slate-700 flex justify-between items-center">
                <div className="flex items-center gap-3">
                  <span className="text-2xl">{h.icon}</span>
                  <div>
                    <h3 className="font-bold text-sm text-slate-200">{h.name} <span className="text-xs text-slate-500">(x{state.housing[h.id]})</span></h3>
                    <p className="text-xs text-amber-400">+{h.pop} Pop</p>
                  </div>
                </div>
                <button 
                  onClick={() => buyHousing(h.id, h.cost)}
                  disabled={state.money < h.cost}
                  className="px-3 py-1.5 text-xs bg-blue-600 hover:bg-blue-500 disabled:bg-slate-700 disabled:text-slate-500 text-white rounded-lg font-bold"
                >
                  {formatMoney(h.cost)}
                </button>
              </div>
            ))}
          </div>
        </section>

        {/* COLUMN 2: Workplaces (Industry) */}
        <section>
          <div className="flex justify-between items-end mb-3 border-b border-slate-800 pb-2">
            <h2 className="text-lg font-bold text-white flex items-center gap-2">
              <span>🏗️</span> Workplaces
            </h2>
          </div>
          <div className="grid grid-cols-1 gap-2">
            {BUILDINGS.map(b => (
              <div key={b.id} className="bg-slate-800 rounded-xl p-3 border border-slate-700 hover:border-slate-500 transition-colors">
                <div className="flex justify-between items-start mb-2">
                  <div className="flex items-center gap-2">
                    <span className="text-2xl">{b.icon}</span>
                    <div>
                      <h3 className="font-bold text-sm text-slate-200">{b.name}</h3>
                      <p className="text-xs text-slate-400">Owned: {state.buildings[b.id]}</p>
                    </div>
                  </div>
                </div>
                <div className="text-[10px] text-slate-400 mb-2 space-y-0.5">
                  <div className="flex justify-between"><span>Max Jobs:</span> <span className="text-slate-200">+{b.maxWorkers}</span></div>
                  <div className="flex justify-between"><span>Wage/Job:</span> <span className="text-rose-400">-{formatMoney(b.wage)}</span></div>
                </div>
                <button 
                  onClick={() => buyBuilding(b.id, b.cost)}
                  disabled={state.money < b.cost}
                  className="w-full py-1.5 text-xs bg-blue-600 hover:bg-blue-500 disabled:bg-slate-700 disabled:text-slate-500 text-white rounded-lg font-bold"
                >
                  Build ({formatMoney(b.cost)})
                </button>
              </div>
            ))}
          </div>
        </section>

        {/* COLUMN 3: Hiring & Production */}
        <section>
          <div className="flex justify-between items-end mb-3 border-b border-slate-800 pb-2 sticky top-0 bg-slate-950 z-10 pt-2">
            <h2 className="text-lg font-bold text-white flex items-center gap-2">
              <span>👥</span> Hiring
            </h2>
          </div>

          <div className="space-y-3">
            {BUILDINGS.filter(b => state.buildings[b.id] > 0).length === 0 && (
              <div className="text-center p-6 bg-slate-900 rounded-xl border border-slate-800 border-dashed text-sm text-slate-500">
                Purchase an industry building to hire workers.
              </div>
            )}

            {BUILDINGS.filter(b => state.buildings[b.id] > 0).map(b => {
              const currentWorkers = state.workers[b.id];
              const maxWorkers = state.buildings[b.id] * b.maxWorkers;
              const isFull = currentWorkers >= maxWorkers;
              const popCapped = employedPop >= totalPop;

              return (
                <div key={b.id} className="bg-slate-800 rounded-xl p-3 border border-slate-700 flex flex-col gap-3">
                  <div className="flex items-center gap-3">
                    <span className="text-2xl bg-slate-900 p-2 rounded-lg">{b.icon}</span>
                    <div className="flex-1">
                      <h3 className="font-bold text-sm text-slate-200">{b.name}</h3>
                      <div className="text-[10px] text-slate-400 flex justify-between mt-1">
                        <span className="text-amber-400">Prod: +{currentWorkers}/s</span>
                        <span className="text-rose-400">Bill: -{formatMoney(currentWorkers * b.wage)}</span>
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center justify-between bg-slate-900 p-2 rounded-lg">
                    <div className="text-center px-2">
                      <div className="text-sm font-mono font-bold text-slate-200">{currentWorkers} / {maxWorkers}</div>
                      <div className="text-[9px] text-slate-500 uppercase">Hired</div>
                    </div>
                    
                    <div className="flex gap-2">
                      <button 
                        onClick={() => fireWorker(b.id)}
                        disabled={currentWorkers === 0}
                        title="Fire Worker"
                        className="w-8 h-8 rounded-lg bg-rose-900/50 text-rose-400 hover:bg-rose-600 hover:text-white disabled:opacity-30 flex items-center justify-center font-bold text-lg"
                      >
                        -
                      </button>
                      <button 
                        onClick={() => hireWorker(b.id)}
                        disabled={isFull || popCapped}
                        title={popCapped ? "Need more housing!" : "Hire Worker"}
                        className="w-8 h-8 rounded-lg bg-emerald-900/50 text-emerald-400 hover:bg-emerald-600 hover:text-white disabled:opacity-30 flex items-center justify-center font-bold text-lg"
                      >
                        +
                      </button>
                    </div>
                  </div>
                </div>
              )
            })}
          </div>
        </section>

        {/* COLUMN 3: The Market */}
        <section>
          <div className="flex justify-between items-end mb-3 border-b border-slate-800 pb-2 sticky top-0 bg-slate-950 z-10 pt-2">
            <h2 className="text-lg font-bold text-white flex items-center gap-2">
              <span>📈</span> Export Market
            </h2>
            <div className="text-xs text-slate-500 font-mono">Next tick: <span className="text-amber-400">{state.marketTimer}s</span></div>
          </div>

          <div className="space-y-3">
            {BUILDINGS.filter(b => state.inventory[b.id] > 0 || state.buildings[b.id] > 0).length === 0 && (
              <div className="text-center p-6 bg-slate-900 rounded-xl border border-slate-800 border-dashed text-sm text-slate-500">
                Produce goods to sell them on the market.
              </div>
            )}

            {BUILDINGS.filter(b => state.inventory[b.id] > 0 || state.buildings[b.id] > 0).map(b => {
              const currentPrice = b.basePrice * state.priceMultipliers[b.id];
              const percentOfBase = Math.round(state.priceMultipliers[b.id] * 100);
              const trend = state.priceTrends[b.id];
              const inventory = Math.floor(state.inventory[b.id]);
              
              return (
                <div key={b.id} className="bg-slate-800 rounded-xl p-3 border border-slate-700">
                  <div className="flex justify-between items-start mb-2">
                    <div className="flex items-center gap-2">
                      <span className="text-xl">{b.icon}</span>
                      <div>
                        <h3 className="font-bold text-sm text-slate-200">{b.export}</h3>
                        <div className="text-xs font-mono text-slate-300">In Stock: {inventory.toLocaleString()}</div>
                      </div>
                    </div>
                    <div className="text-right">
                      <div className="text-sm font-bold text-emerald-400">{formatMoney(currentPrice)} <span className="text-[10px] text-slate-500">/unit</span></div>
                      <div className={`text-[10px] font-bold flex items-center justify-end gap-1 ${trend === 'up' ? 'text-emerald-500' : 'text-rose-500'}`}>
                        {trend === 'up' ? '▲' : '▼'} {percentOfBase}% of avg
                      </div>
                    </div>
                  </div>

                  <div className="flex gap-1 mt-3">
                    <button onClick={() => sellInventory(b.id, 10)} disabled={inventory < 10} className="flex-1 py-1 text-[10px] bg-slate-700 hover:bg-slate-600 disabled:opacity-50 text-white rounded font-bold">Sell 10%</button>
                    <button onClick={() => sellInventory(b.id, 50)} disabled={inventory < 2} className="flex-1 py-1 text-[10px] bg-slate-700 hover:bg-slate-600 disabled:opacity-50 text-white rounded font-bold">Sell 50%</button>
                    <button onClick={() => sellInventory(b.id, 100)} disabled={inventory < 1} className="flex-1 py-1 text-[10px] bg-emerald-700 hover:bg-emerald-600 disabled:opacity-50 text-white rounded font-bold">Sell All</button>
                  </div>
                </div>
              )
            })}
          </div>
        </section>

      </main>

      {/* Game Over Modal */}
      {state.gameOver && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 p-8 rounded-3xl border border-rose-900 shadow-[0_0_50px_rgba(225,29,72,0.3)] max-w-md w-full text-center relative overflow-hidden">
            <div className="text-6xl mb-4">📉</div>
            <h2 className="text-4xl font-black text-white mb-2">BANKRUPT!</h2>
            <p className="text-rose-400 mb-6">You failed to make payroll.</p>
            
            <div className="bg-slate-950 p-4 rounded-xl mb-8 flex justify-center gap-8">
              <div>
                <div className="text-xs text-slate-500 uppercase font-bold">Survived</div>
                <div className="text-2xl text-slate-200 font-mono">{formatTime(state.timeAlive)}</div>
              </div>
              <div>
                <div className="text-xs text-slate-500 uppercase font-bold">Workforce</div>
                <div className="text-2xl text-slate-200 font-mono">{employedPop}</div>
              </div>
            </div>

            <button 
              onClick={hardReset}
              className="w-full py-4 bg-rose-600 hover:bg-rose-500 text-white rounded-xl font-bold text-lg transition-colors"
            >
              Start New Company
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
